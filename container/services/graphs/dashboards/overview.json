          "rawQueryText": "select ts/3600*3600 as time, sum(case when agent_id is null then cost_usd else 0 end) as Manager, sum(case when agent_id is not null then cost_usd else 0 end) as Agents from message_costs where ts between $__from/1000 and $__to/1000 group by 1 order by 1",
