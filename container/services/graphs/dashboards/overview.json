      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select 100 - five_hour_used as left from samples where five_hour_used is not null order by ts desc limit 1",
          "rawQueryText": "select 100 - five_hour_used as left from samples where five_hour_used is not null order by ts desc limit 1",
          "queryType": "table"
