          "refId": "A",
          "queryText": "select cast(strftime('%s', day) as integer) as time, cost_usd as \"cost\" from cost_per_day where cast(strftime('%s', day) as integer) between $__from/1000-86400 and $__to/1000 order by day",
          "rawQueryText": "select cast(strftime('%s', day) as integer) as time, cost_usd as \"cost\" from cost_per_day where cast(strftime('%s', day) as integer) between $__from/1000-86400 and $__to/1000 order by day",
