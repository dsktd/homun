    {
      "id": 10,
      "title": "Fresh tokens per workspace per day (input + output + cache writes)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts/86400*86400 as time, case when cwd = '/home/purplg/claude' then 'manager' when cwd like '/home/purplg/claude/%' then substr(substr(cwd, 21), 1, instr(substr(cwd, 21) || '/', '/') - 1) else 'other' end as workspace, sum(input_tokens + output_tokens + cache_creation_input_tokens) as tokens from messages where ts between $__from/1000 and $__to/1000 group by 1, 2 order by 1",
          "rawQueryText": "select ts/86400*86400 as time, case when cwd = '/home/purplg/claude' then 'manager' when cwd like '/home/purplg/claude/%' then substr(substr(cwd, 21), 1, instr(substr(cwd, 21) || '/', '/') - 1) else 'other' end as workspace, sum(input_tokens + output_tokens + cache_creation_input_tokens) as tokens from messages where ts between $__from/1000 and $__to/1000 group by 1, 2 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
