      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts/3600*3600 as time, model, sum(input_tokens + output_tokens + cache_creation_input_tokens) as tokens from messages where ts between $__from/1000 and $__to/1000 group by 1, 2 order by 1",
