            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select strftime('%Y-W%W', woke_at, 'unixepoch') as week, sum(outcome = 'fixed') as fixed, sum(outcome = 'partial') as partial, sum(outcome = 'escalated') as escalated, sum(outcome = 'nothing-wrong') as \"nothing-wrong\" from repairs where woke_at > strftime('%s', 'now', '-84 days') group by week order by week",
          "rawQueryText": "select strftime('%Y-W%W', woke_at, 'unixepoch') as week, sum(outcome = 'fixed') as fixed, sum(outcome = 'partial') as partial, sum(outcome = 'escalated') as escalated, sum(outcome = 'nothing-wrong') as \"nothing-wrong\" from repairs where woke_at > strftime('%s', 'now', '-84 days') group by week order by week",
          "queryType": "table",
