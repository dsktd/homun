    {
      "type": "timeseries",
      "title": "Which roles ran each day?",
      "description": "Distinct subagents per day by role.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select cast(strftime('%s', date(ts,'unixepoch')) as integer) as time, coalesce(agent_type,'unknown') as role, count(distinct agent_id) as subagents from messages where agent_id is not null and ('$agent_type' = 'All' or agent_type = '$agent_type') and ts between $__from/1000 and $__to/1000 group by 1, 2 order by 1",
          "rawQueryText": "select cast(strftime('%s', date(ts,'unixepoch')) as integer) as time, coalesce(agent_type,'unknown') as role, count(distinct agent_id) as subagents from messages where agent_id is not null and ('$agent_type' = 'All' or agent_type = '$agent_type') and ts between $__from/1000 and $__to/1000 group by 1, 2 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": -1,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisBorderShow": false
          },
          "noValue": "no data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?subagents$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
