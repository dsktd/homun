    {
      "type": "stat",
      "title": "How often do background runs fail?",
      "description": "Failed share of finished background runs, last 7 days.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select 100.0 * sum(state = 'failed') / nullif(sum(state in ('done','failed')), 0) as failed from agent_runs where started_at >= cast(strftime('%s','now') as integer) - 7 * 86400",
          "rawQueryText": "select 100.0 * sum(state = 'failed') / nullif(sum(state in ('done','failed')), 0) as failed from agent_runs where started_at >= cast(strftime('%s','now') as integer) - 7 * 86400",
          "queryType": "table",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 10
              },
              {
                "color": "#d03b3b",
                "value": 25
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Did background runs succeed?",
      "description": "Background runs per day by outcome.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select cast(strftime('%s', date(started_at,'unixepoch')) as integer) as time, sum(state = 'done') as done, sum(state = 'failed') as failed, sum(state = 'stopped') as stopped from agent_runs where kind = 'background' and started_at between $__from/1000 and $__to/1000 group by 1 order by 1",
          "rawQueryText": "select cast(strftime('%s', date(started_at,'unixepoch')) as integer) as time, sum(state = 'done') as done, sum(state = 'failed') as failed, sum(state = 'stopped') as stopped from agent_runs where kind = 'background' and started_at between $__from/1000 and $__to/1000 group by 1 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": -1,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisBorderShow": false
          },
          "noValue": "no data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?done$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?failed$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?stopped$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8984"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
