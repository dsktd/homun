    {
      "transformations": [],
      "type": "table",
      "title": "What did agents just do?",
      "description": "Newest subagents with role, model and tokens.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select substr(agent_id,1,8) as agent, coalesce(agent_type,'unknown') as type, case when model like '%opus%' then 'opus' when model like '%sonnet%' then 'sonnet' when model like '%haiku%' then 'haiku' when model like '%fable%' then 'fable' else 'other' end as model, count(*) as messages, sum(output_tokens) as output, round((max(ts)-min(ts))/60.0,1) as minutes, max(ts) * 1000 as last from messages where agent_id is not null and ('$agent_type' = 'All' or agent_type = '$agent_type') and ts between $__from/1000 and $__to/1000 group by agent_id order by max(ts) desc limit 25",
          "rawQueryText": "select substr(agent_id,1,8) as agent, coalesce(agent_type,'unknown') as type, case when model like '%opus%' then 'opus' when model like '%sonnet%' then 'sonnet' when model like '%haiku%' then 'haiku' when model like '%fable%' then 'fable' else 'other' end as model, count(*) as messages, sum(output_tokens) as output, round((max(ts)-min(ts))/60.0,1) as minutes, max(ts) * 1000 as last from messages where agent_id is not null and ('$agent_type' = 'All' or agent_type = '$agent_type') and ts between $__from/1000 and $__to/1000 group by agent_id order by max(ts) desc limit 25",
          "queryType": "table",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last"
            },
            "properties": [
              {
