{
  "uid": "budget",
  "title": "Budget",
  "tags": [
    "usage"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "5-hour and 7-day budget used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, five_hour_used as \"5-hour used\", seven_day_used as \"7-day used\" from samples where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, five_hour_used as \"5-hour used\", seven_day_used as \"7-day used\" from samples where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "Percent of each window used, one point per status line sample; the red line is the limit (100). A drop is the window resetting."
    },
    {
      "id": 2,
      "title": "Cost of each sample (5-hour points used)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, delta as \"points used\" from budget_deltas where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, delta as \"points used\" from budget_deltas where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "fillOpacity": 60,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "How many points of the shared 5-hour window each sample used up (budget_deltas)."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
