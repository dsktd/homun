{
  "uid": "modes",
  "title": "Modes",
  "description": "Resource mode history, agent slots and how agent runs ended.",
  "tags": [
    "usage"
  ],
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "usage"
      ],
      "asDropdown": false,
      "icon": "external link",
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Resource mode over time",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, mode from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, mode from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "burn": {
                  "color": "orange",
                  "index": 0,
                  "text": "burn"
                },
                "normal": {
                  "color": "green",
                  "index": 1,
                  "text": "normal"
                },
                "frugal": {
                  "color": "blue",
                  "index": 2,
                  "text": "frugal"
                },
                "hold": {
                  "color": "purple",
                  "index": 3,
                  "text": "hold"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "The effective mode: the Manager's override while one is active, otherwise the proposal."
    },
    {
      "id": 2,
      "title": "Time per mode",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select mode, sum(dur) / 3600.0 as hours from (select mode, min(coalesce(lead(ts) over (order by ts), cast(strftime('%s','now') as integer)), $__to/1000) - max(ts, $__from/1000) as dur from mode_history) where dur > 0 group by mode order by hours desc",
          "rawQueryText": "select mode, sum(dur) / 3600.0 as hours from (select mode, min(coalesce(lead(ts) over (order by ts), cast(strftime('%s','now') as integer)), $__to/1000) - max(ts, $__from/1000) as dur from mode_history) where dur > 0 group by mode order by hours desc",
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "burn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "normal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "frugal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Proposed and effective mode",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, case proposed when 'hold' then 0 when 'frugal' then 1 when 'normal' then 2 when 'burn' then 3 end as proposed, case mode when 'hold' then 0 when 'frugal' then 1 when 'normal' then 2 when 'burn' then 3 end as effective from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, case proposed when 'hold' then 0 when 'frugal' then 1 when 'normal' then 2 when 'burn' then 3 end as proposed, case mode when 'hold' then 0 when 'frugal' then 1 when 'normal' then 2 when 'burn' then 3 end as effective from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 3,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "index": 0,
                  "text": "hold"
                },
                "1": {
                  "index": 1,
                  "text": "frugal"
                },
                "2": {
                  "index": 2,
                  "text": "normal"
                },
                "3": {
                  "index": 3,
                  "text": "burn"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "effective"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "They differ while a Manager override is in force."
    },
    {
      "id": 4,
      "title": "Agent runs by outcome per day (UTC)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select cast(strftime('%s', date(started_at,'unixepoch')) as integer) as time, sum(state = 'done') as done, sum(state = 'failed') as failed, sum(state = 'stopped') as stopped, sum(state = 'working') as working from agent_runs where started_at between $__from/1000 and $__to/1000 group by 1 order by 1",
          "rawQueryText": "select cast(strftime('%s', date(started_at,'unixepoch')) as integer) as time, sum(state = 'done') as done, sum(state = 'failed') as failed, sum(state = 'stopped') as stopped, sum(state = 'working') as working from agent_runs where started_at between $__from/1000 and $__to/1000 group by 1 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "fillOpacity": 45,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "done"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stopped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "working"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "title": "Failure rate, last 7 days",
      "type": "stat",
      "gridPos": {
        "x": 10,
        "y": 14,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select 100.0 * sum(state = 'failed') / sum(state in ('done','failed')) as failed from agent_runs where started_at >= cast(strftime('%s','now') as integer) - 7 * 86400",
          "rawQueryText": "select 100.0 * sum(state = 'failed') / sum(state in ('done','failed')) as failed from agent_runs where started_at >= cast(strftime('%s','now') as integer) - 7 * 86400",
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "description": "Failed runs as a share of runs that finished (done or failed); stopped runs are left out."
    },
    {
      "id": 6,
      "title": "Agent slots and projected 7-day use",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, slots, proj7 as projected_7d_percent from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, slots, proj7 as projected_7d_percent from mode_history where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "slots"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 3
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "projected_7d_percent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.lineInterpolation",
                "value": "linear"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    }
  ]
}
