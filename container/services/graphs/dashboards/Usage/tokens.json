    {
      "type": "timeseries",
      "title": "Which workspaces burn it?",
      "description": "",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "with t as (select case when cwd like '%/claude' then 'manager' when cwd like '%/claude/%' then substr(substr(cwd, instr(cwd, '/claude/') + 8), 1, instr(substr(cwd, instr(cwd, '/claude/') + 8) || '/', '/') - 1) else 'other' end as ws, ts, input_tokens + output_tokens + cache_creation_input_tokens as n from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%')), top as (select ws from t group by ws order by sum(n) desc limit 7) select ts/86400*86400 as time, case when ws in (select ws from top) then ws else 'rest' end as workspace, sum(n) as tokens from t group by 1, 2 order by 1",
          "rawQueryText": "with t as (select case when cwd like '%/claude' then 'manager' when cwd like '%/claude/%' then substr(substr(cwd, instr(cwd, '/claude/') + 8), 1, instr(substr(cwd, instr(cwd, '/claude/') + 8) || '/', '/') - 1) else 'other' end as ws, ts, input_tokens + output_tokens + cache_creation_input_tokens as n from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%')), top as (select ws from t group by ws order by sum(n) desc limit 7) select ts/86400*86400 as time, case when ws in (select ws from top) then ws else 'rest' end as workspace, sum(n) as tokens from t group by 1, 2 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
