    {
      "type": "timeseries",
      "title": "What do models burn?",
      "description": "",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts/3600*3600 as time, case when model like '%opus%' then 'opus' when model like '%sonnet%' then 'sonnet' when model like '%haiku%' then 'haiku' when model like '%fable%' then 'fable' else 'other' end as model, sum(input_tokens + output_tokens + cache_creation_input_tokens) as tokens from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%') group by 1, 2 order by 1",
          "rawQueryText": "select ts/3600*3600 as time, case when model like '%opus%' then 'opus' when model like '%sonnet%' then 'sonnet' when model like '%haiku%' then 'haiku' when model like '%fable%' then 'fable' else 'other' end as model, sum(input_tokens + output_tokens + cache_creation_input_tokens) as tokens from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%') group by 1, 2 order by 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 85,
            "showPoints": "never",
