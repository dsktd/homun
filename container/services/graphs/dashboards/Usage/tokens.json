          "refId": "A",
          "queryText": "select ts/86400*86400 as time, sum(case when agent_id is null then output_tokens else 0 end) as Manager, sum(case when agent_id is not null then output_tokens else 0 end) as Agents from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%') group by 1 order by 1",
          "rawQueryText": "select ts/86400*86400 as time, sum(case when agent_id is null then output_tokens else 0 end) as Manager, sum(case when agent_id is not null then output_tokens else 0 end) as Agents from messages where ts between $__from/1000 and $__to/1000 and ('$model' = 'All' or model like '%$model%') group by 1 order by 1",
