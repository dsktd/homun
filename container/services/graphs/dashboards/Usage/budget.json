    {
      "type": "timeseries",
      "title": "Budget used",
      "description": "5-hour and 7-day budget used over the range.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "usage"
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "A",
          "queryText": "select ts as time, five_hour_used as \"5-hour used\", seven_day_used as \"7-day used\" from samples where ts between $__from/1000 and $__to/1000 order by ts",
          "rawQueryText": "select ts as time, five_hour_used as \"5-hour used\", seven_day_used as \"7-day used\" from samples where ts between $__from/1000 and $__to/1000 order by ts",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 3600000,
            "barAlignment": -1,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisBorderShow": false
          },
          "noValue": "no data",
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?5-hour used$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?7-day used$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
