  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "5-hour resets",
        "enable": true,
        "iconColor": "#3987e5",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "usage"
        },
        "target": {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "Anno",
          "queryText": "select distinct five_hour_resets_at*1000 as time, '5-hour window reset' as text, '5h' as tags from samples where five_hour_resets_at between $__from/1000 and $__to/1000",
          "rawQueryText": "select distinct five_hour_resets_at*1000 as time, '5-hour window reset' as text, '5h' as tags from samples where five_hour_resets_at between $__from/1000 and $__to/1000",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      },
      {
        "name": "7-day resets",
        "enable": true,
        "iconColor": "#8a5fd6",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "usage"
        },
        "target": {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "Anno",
          "queryText": "select distinct seven_day_resets_at*1000 as time, '7-day window reset' as text, '7d' as tags from samples where seven_day_resets_at between $__from/1000 and $__to/1000",
          "rawQueryText": "select distinct seven_day_resets_at*1000 as time, '7-day window reset' as text, '7d' as tags from samples where seven_day_resets_at between $__from/1000 and $__to/1000",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      },
      {
        "name": "Mode changes",
        "enable": true,
        "iconColor": "#fab219",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "usage"
        },
        "target": {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "Anno",
          "queryText": "select ts*1000 as time, 'mode: ' || mode as text, 'mode' as tags from (select ts, mode, lag(mode) over (order by ts) as p from mode_history) where mode is not p and ts between $__from/1000 and $__to/1000",
          "rawQueryText": "select ts*1000 as time, 'mode: ' || mode as text, 'mode' as tags from (select ts, mode, lag(mode) over (order by ts) as p from mode_history) where mode is not p and ts between $__from/1000 and $__to/1000",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      },
      {
        "name": "Mechanic repairs",
        "enable": true,
        "iconColor": "#d03b3b",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "usage"
        },
        "target": {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "usage"
          },
          "refId": "Anno",
          "queryText": "select woke_at*1000 as time, 'repair ' || outcome || ': ' || coalesce(broken,'') as text, 'repair' as tags from repairs where woke_at between $__from/1000 and $__to/1000",
          "rawQueryText": "select woke_at*1000 as time, 'repair ' || outcome || ': ' || coalesce(broken,'') as text, 'repair' as tags from repairs where woke_at between $__from/1000 and $__to/1000",
          "queryType": "table",
          "timeColumns": [
            "time"
          ]
        }
      }
