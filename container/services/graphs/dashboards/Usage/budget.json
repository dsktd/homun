{
  "uid": "budget",
  "title": "Budget and pace",
  "description": "Are we on pace for both windows, and what did the mode do about it?",
  "tags": [
    "homun",
    "usage"
  ],
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
