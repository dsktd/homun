#!/usr/bin/env sh
# The Manager's wake-up on the scheduler's events file. `cursor` holds the byte
# offset of the last line printed, so nothing is lost or repeated across restarts
# or while no one listens; `listener` is the heartbeat the service checks.
#   listen        follow: print each new line as it arrives (Monitor; 30 minutes at most)
#   listen once   wait for the first new line(s), print them and exit (a background
#                 Bash task: one notification per event, nothing between events)
cd "$(dirname "$0")" || exit 1
export LC_ALL=C
touch events listener
[ -s cursor ] || wc -c <events | tr -d ' ' >cursor
[ "$(cat cursor)" -le "$(wc -c <events)" ] || echo 0 >cursor # events was emptied: start over
if [ "$1" = once ]; then
	while [ "$(wc -c <events)" -le "$(cat cursor)" ]; do
		touch listener
		sleep 5
	done
	size=$(wc -c <events)
	tail -c +"$(($(cat cursor) + 1))" events | head -c "$((size - $(cat cursor)))"
	printf '%s' "$size" >cursor
	exit 0
fi
pid=$$
(while kill -0 "$pid" 2>/dev/null; do touch listener; sleep 60; done) &
off=$(cat cursor)
tail -c +"$((off + 1))" -F events 2>/dev/null |
	while IFS= read -r line; do
		printf '%s\n' "$line"
		off=$((off + ${#line} + 1))
		printf '%s' "$off" >cursor
	done
