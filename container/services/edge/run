#!/usr/bin/env sh
# edge: the internet-facing Caddy (127.0.0.1:8444, admin 127.0.0.1:2020) for the share hosts,
# plus the dumbpipe tunnel the relay box dials (stable key in tunnel-secret, 600), plus a
# 15 s tick that drops expired test mappings and pages. No PORT in env on purpose: the LAN
# proxy must never list or route it. Config: claude-services edge help.
set -u
cd "$(dirname "$0")" || exit
umask 077
edge=/opt/homun/claude-edge
# A test mapping never outlives the edge (no keep): a recreate or restart ends it
rm -f test-route.json
python3 -I "$edge" config || exit
dumbpipe=$(nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths \
	github:NixOS/nixpkgs/4fe25e12eb9f4c744966dd3de5a05246cf098601#dumbpipe)/bin/dumbpipe || exit
[ -s tunnel-secret ] || python3 -I "$edge" tunnel >/dev/null || exit
# The key and the ticket stay out of the log: dumbpipe prints both at startup. It exits
# when its iroh endpoint drops; the same key brings back the same ticket, so restart it
(while :; do
	IROH_SECRET=$(cat tunnel-secret) "$dumbpipe" listen-tcp --host 127.0.0.1:8444 2>&1
	echo "edge: dumbpipe exited ($?), restarting in 2 s"; sleep 2
done) | grep --line-buffered -v -e 'secret' -e 'ticket' -e 'dumbpipe connect' -e '^ *[a-z0-9]\{40,\}$' &
(while sleep 15; do python3 -I "$edge" tick; done) &
exec caddy run --config Caddyfile --adapter caddyfile
