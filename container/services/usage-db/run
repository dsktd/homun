#!/usr/bin/env sh
# usage-db: keep usage.sqlite up to date from ~/.claude/usage.jsonl (every
# INTERVAL seconds) and serve charts of it on 127.0.0.1:PORT (serve.py).
# Started by claude-services; stays in the foreground, which exits if the
# server dies so the supervisor restarts both.
set -u
cd "$(dirname "$0")" || exit
jsonl=${USAGE_JSONL:-$HOME/.claude/usage.jsonl}

import() { nu ./import.nu "$jsonl" usage.sqlite; }

import
# Installed once into the persistent profile rather than `nix shell` on every
# start (instant and offline, but pinned until `nix profile upgrade --profile /nix/var/nix/profiles/default python3`)
command -v python3 >/dev/null || flock /tmp/claude-nix-profile.lock nix profile install --profile /nix/var/nix/profiles/default nixpkgs#python3 || exit
python3 -I ./serve.py usage.sqlite "${PORT:-8420}" &
server=$!

while kill -0 "$server" 2>/dev/null; do
	sleep "${INTERVAL:-300}"
	import
done
wait "$server"
