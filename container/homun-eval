#!/usr/bin/env python3
"""Run the real emacsclient and log every --eval/-e sent to the container Emacs socket.

The `emacsclient` shim (entrypoint.sh, Containerfile) calls this only when an eval flag
is present. One JSON line per call is appended to ~/claude/.services/emacs/eval-log.jsonl:
ts, role, session, caller, argv0, kind, form (secret string literals redacted), code, ms,
result_len, result (first 2000 chars). Failures are logged too. A log write that fails is
dropped silently: the call itself is never affected.
"""

import fcntl
import gzip
import json
import os
import re
import shutil
import subprocess
import sys
import time

REAL = "/nix/var/nix/profiles/emacs/bin/emacsclient"
HOME = os.path.expanduser("~")
DIR = os.path.join(HOME, "claude", ".services", "emacs")
SOCKET = os.path.join(DIR, "socket")
LOG = os.path.join(DIR, "eval-log.jsonl")
LIMIT = 20 * 1024 * 1024
KEEP = 3
RESULT_MAX = 2000
EVAL_FLAGS = ("-e", "--eval", "--evaluate")
KNOWN = ("homun-emacs", "claude-emacs", "claude-view", "claude-question", "claude-scrollback-edit")
SECRET = re.compile(r"widgetry-secret|secret-widget", re.I)
STRING = re.compile(r'"(?:[^"\\]|\\.)*"')


def socket_of(args):
    """The socket named by -s/--socket-name (or EMACS_SOCKET_NAME), else None."""
    for i, a in enumerate(args):
        if a in ("-s", "--socket-name") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--socket-name="):
            return a.split("=", 1)[1]
    return os.environ.get("EMACS_SOCKET_NAME")


def form_of(args):
    """The text after the eval flag: the form and, for (homun-rpc), its words."""
    for i, a in enumerate(args):
        if a in EVAL_FLAGS:
            return " ".join(args[i + 1 :])
        if a.startswith("--eval="):
            return " ".join([a.split("=", 1)[1]] + args[i + 1 :])
    return None


def redact(form):
    return STRING.sub('"<redacted>"', form) if SECRET.search(form) else form


def parent():
    """(short cmdline, argv0 basename) of the calling process."""
    try:
        with open(f"/proc/{os.getppid()}/cmdline", "rb") as f:
            parts = f.read().decode(errors="replace").split("\0")
    except OSError:
        return "", ""
    parts = [p for p in parts if p]
    return " ".join(parts)[:160], os.path.basename(parts[0]) if parts else ""


def kind_of(form, cmdline):
    if os.environ.get("HOMUN_EVAL_KIND"):
        return os.environ["HOMUN_EVAL_KIND"]
    for name in KNOWN:
        if name in cmdline:
            return name
    return "rpc" if form.lstrip().startswith("(homun-rpc)") else "raw"


def rotate():
    try:
        if os.path.getsize(LOG) <= LIMIT:
            return
    except OSError:
        return
    for n in range(KEEP, 1, -1):
        if os.path.exists(f"{LOG}.{n - 1}.gz"):
            os.replace(f"{LOG}.{n - 1}.gz", f"{LOG}.{n}.gz")
    with open(LOG, "rb") as src, gzip.open(f"{LOG}.1.gz", "wb") as dst:
        shutil.copyfileobj(src, dst)
    open(LOG, "w").close()


def append(entry):
    try:
        with open(LOG, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            rotate()
            f.write(json.dumps(entry) + "\n")
    except OSError:
        pass


def main(args):
    form = form_of(args)
    sock = socket_of(args)
    if form is None or not sock or os.path.abspath(sock) != SOCKET:
        os.execv(REAL, [REAL] + args)
    start = time.monotonic()
    p = subprocess.run([REAL] + args, stdout=subprocess.PIPE)
    ms = round((time.monotonic() - start) * 1000)
    sys.stdout.buffer.write(p.stdout)
    sys.stdout.flush()
    result = p.stdout.decode(errors="replace")
    cmdline, argv0 = parent()
    append(
        {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "role": os.environ.get("CLAUDE_ROLE", "manager"),
            "session": os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID"),
            "caller": cmdline,
            "argv0": argv0,
            "kind": kind_of(form, cmdline),
            "form": redact(form),
            "code": p.returncode,
            "ms": ms,
            "result_len": len(result),
            "result": "" if SECRET.search(form) else result[:RESULT_MAX],
        }
    )
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
