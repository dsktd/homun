#!/usr/bin/env python3
"""Claude Code hooks for the coach role (managed-settings.json), in the primary session only.

coach-hook brief  PreToolUse (matcher Agent): checks the brief of a spawn against the standing
                  rules with fixed patterns, never denies; a gap is noted in the session's context
                  ("coach: brief lacks ...") and every spawn is logged.
coach-hook run    SubagentStop: logs the finished run (agent id, description, model, duration,
                  tokens) with a deterministic grade of its report: already done before the spawn,
                  rework needed, verified and unverified claims.

Both append one JSON line to $COACH_DIR/agents.jsonl (default ~/claude/.services/coach), kind
"spawn" or "run"; a run is matched to its spawn by the sha256 of the prompt. No model call; every
error ends in exit 0 with no output, so a spawn is never blocked.
"""

import hashlib
import json
import os
import re
import sys
import time
from datetime import datetime

MB = 1024 * 1024
KEEP_LINES = 5000
SPAWN_LOOKBACK = 500


def _rx(pattern):
    return re.compile(pattern, re.IGNORECASE)


class Rule:
    """One standing rule: applies when `when` matches the brief, satisfied when every `need`
    does, or when `instead` (a tool that keeps the rule itself) does."""

    def __init__(self, name, lacks, when, need, instead=None):
        self.name, self.lacks = name, lacks
        self.when, self.need = _rx(when), [_rx(n) for n in need]
        self.instead = _rx(instead) if instead else None

    def gap(self, text):
        if not self.when.search(text):
            return False
        if self.instead and self.instead.search(text):
            return False
        return not all(n.search(text) for n in self.need)


REPO = r"\b(repo|repository|worktree|commit|branch|git)\b"
RULES = (
    Rule(
        "existing_work",
        "a check of git log / existing work first",
        REPO,
        [
            r"git log|existing work|already (done|exists|landed)|grep .*log|check .*first"
        ],
    ),
    Rule(
        "lease",
        "the lease rule (read the lease first, wait if held, never overwrite)",
        r"\bhomun\b|claude-wrapper|_tools/",
        [r"\blease\b", r"\bwait|\bheld\b"],
        r"\bhomun-land\b",
    ),
    Rule(
        "docs",
        "a pointer to the repo's skill / AGENTS.md / docs",
        REPO,
        [r"skill|AGENTS\.md|CLAUDE\.md|README|\bdocs?\b"],
    ),
    Rule(
        "emacs",
        "the Emacs rule (the homun emacs MCP tools, never raw emacsclient)",
        r"\bemacs|cockpit|\.el\b|\bert\b",
        [r"\bmcp\b|homun-emacs|no raw emacsclient|never raw emacsclient"],
    ),
    Rule(
        "trailers",
        "the no-Claude-trailers rule for commits",
        r"\bcommit",
        [r"trailer|co-authored-by"],
    ),
)


def check_brief(text):
    """The rules the brief misses, in RULES order."""
    return [r for r in RULES if r.gap(text)]


GRADES = {
    "already_done": _rx(
        r"already (done|in place|exists|existed|landed|implemented|fixed|on main)|"
        r"nothing to (do|change)|no change (was )?needed"
    ),
    "rework": _rx(
        r"rework|needs? (a )?(follow-up|another pass|fixing)|not (yet )?(done|finished|working)|"
        r"could not (finish|complete)|\bblocked\b|\bfailed\b"
    ),
}
VERIFIED = _rx(r"\b(verified|checked|tested|passes|passed|confirmed|ran)\b")
UNVERIFIED = _rx(
    r"\b(unverified|untested|not (verified|tested|checked|run)|could not (test|verify|check)|"
    r"did not (test|verify|run|check)|should work|probably)\b"
)


def grade(report):
    lines = [ln for ln in report.splitlines() if ln.strip()]
    unverified = sum(1 for ln in lines if UNVERIFIED.search(ln))
    verified = sum(
        1 for ln in lines if VERIFIED.search(ln) and not UNVERIFIED.search(ln)
    )
    out = {k: bool(rx.search(report)) for k, rx in GRADES.items()}
    out.update(verified=verified, unverified=unverified)
    return out


def prompt_sha(text):
    return hashlib.sha256(text.encode()).hexdigest()[:16]


class Log:
    def __init__(self):
        root = os.environ.get("COACH_DIR") or os.path.expanduser(
            "~/claude/.services/coach"
        )
        self.path = os.path.join(root, "agents.jsonl")

    def append(self, row):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "a") as f:
            f.write(json.dumps(row) + "\n")
        if os.path.getsize(self.path) > MB:
            with open(self.path) as f:
                keep = f.readlines()[-KEEP_LINES:]
            tmp = self.path + ".tmp"
            with open(tmp, "w") as f:
                f.writelines(keep)
            os.replace(tmp, self.path)

    def spawn(self, sha, tool_use_id=None):
        try:
            with open(self.path) as f:
                tail = f.readlines()[-SPAWN_LOOKBACK:]
        except OSError:
            return {}
        for line in reversed(tail):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("kind") != "spawn":
                continue
            if row.get("prompt_sha") == sha or (
                tool_use_id and row.get("tool_use_id") == tool_use_id
            ):
                return row
        return {}


def transcript_path(event):
    """The subagent transcript: the event's own path, else the sibling subagents/ file of the
    parent transcript (the event may carry only the parent's path and the agent id)."""
    path = event.get("agent_transcript_path")
    if path and os.path.exists(path):
        return path
    parent, agent = event.get("transcript_path"), event.get("agent_id")
    if not (parent and agent):
        return path
    session = event.get("session_id") or os.path.basename(parent)[: -len(".jsonl")]
    return os.path.join(
        os.path.dirname(parent), session, "subagents", f"agent-{agent}.jsonl"
    )


def read_meta(path):
    """The sidecar agent-<id>.meta.json: description, spawning tool_use_id, model."""
    try:
        with open(path[: -len(".jsonl")] + ".meta.json") as f:
            meta = json.load(f)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def _text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(c.get("text", "") for c in content if c.get("type") == "text")
    return ""


def _ts(value):
    try:
        return datetime.fromisoformat(value).timestamp()
    except (AttributeError, ValueError):
        return None


class Transcript:
    """What a subagent transcript says about its run: prompt, model, time span, tokens, report."""

    def __init__(self, path):
        self.prompt, self.model, self.report = "", "", ""
        self.tokens = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
        times, seen = [], set()
        try:
            with open(path) as f:
                rows = [json.loads(line) for line in f if line.strip()]
        except (OSError, ValueError, TypeError):
            rows = []
        for row in rows:
            t = _ts(row.get("timestamp"))
            if t:
                times.append(t)
            msg = row.get("message") or {}
            if row.get("type") == "user" and not self.prompt:
                self.prompt = _text(msg.get("content"))
            if row.get("type") != "assistant":
                continue
            self.model = msg.get("model") or self.model
            for c in msg.get("content") or []:
                if c.get("type") == "text" and c.get("text", "").strip():
                    self.report = c["text"]
                elif (
                    c.get("type") == "tool_use" and c.get("name") == "SubagentHandback"
                ):
                    self.report = (c.get("input") or {}).get("message", self.report)
            if msg.get("id") in seen:
                continue
            seen.add(msg.get("id"))
            u = msg.get("usage") or {}
            self.tokens["input"] += u.get("input_tokens", 0)
            self.tokens["output"] += u.get("output_tokens", 0)
            self.tokens["cache_read"] += u.get("cache_read_input_tokens", 0)
            self.tokens["cache_write"] += u.get("cache_creation_input_tokens", 0)
        self.duration_s = round(max(times) - min(times)) if times else None


def on_brief(event, log):
    if event.get("tool_name") != "Agent":
        return None
    ti = event.get("tool_input") or {}
    prompt = ti.get("prompt") or ""
    gaps = check_brief(prompt)
    if event.get("tool_use_id") and log.spawn("", event["tool_use_id"]):
        return None  # the hook fires twice per Agent call: one spawn row, one note
    log.append(
        {
            "ts": int(time.time()),
            "kind": "spawn",
            "session_id": event.get("session_id"),
            "tool_use_id": event.get("tool_use_id"),
            "description": ti.get("description", ""),
            "subagent_type": ti.get("subagent_type", ""),
            "model": ti.get("model", ""),
            "prompt_sha": prompt_sha(prompt),
            "lacks": [g.name for g in gaps],
        }
    )
    if not gaps:
        return None
    note = "coach: brief lacks " + "; ".join(g.lacks for g in gaps)
    return {
        "hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": note}
    }


def on_run(event, log):
    path = transcript_path(event)
    tr = Transcript(path)
    meta = read_meta(path) if path else {}
    report = event.get("last_assistant_message") or tr.report
    sha = prompt_sha(tr.prompt)
    spawn = log.spawn(sha if tr.prompt else "", meta.get("toolUseId"))
    row = {
        "ts": int(time.time()),
        "kind": "run",
        "session_id": event.get("session_id"),
        "agent_id": event.get("agent_id"),
        "tool_use_id": spawn.get("tool_use_id") or meta.get("toolUseId"),
        "agent_type": event.get("agent_type")
        or meta.get("agentType")
        or spawn.get("subagent_type", ""),
        "description": spawn.get("description") or meta.get("description", ""),
        "model": tr.model or meta.get("model") or spawn.get("model", ""),
        "duration_s": tr.duration_s,
        "tokens": tr.tokens,
        "prompt_sha": sha if tr.prompt else None,
        "spawned_at": spawn.get("ts"),
        "brief_lacks": spawn.get("lacks"),
    }
    row.update(grade(report or ""))
    log.append(row)


HANDLERS = {"brief": on_brief, "run": on_run}


def main(argv):
    handler = HANDLERS.get(argv[1] if len(argv) > 1 else "")
    if handler is None:
        return
    try:
        out = handler(json.load(sys.stdin), Log())
    except Exception:  # noqa: BLE001 - a coach hook never blocks or breaks the session
        return
    if out:
        print(json.dumps(out))


if __name__ == "__main__":
    main(sys.argv)
