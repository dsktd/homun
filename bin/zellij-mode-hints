#!/usr/bin/env nu
# Inspect the status bar's per-mode key hints that lib/hints.nu derives from
# zellij/config.kdl. run.nu renders them into the layout at launch; this only
# prints them: `--print` the zjstatus mode_* lines, `--layout` the whole
# rendered layout.kdl.

const ROOT = path self | path expand | path dirname | path dirname

use ($ROOT | path join lib hints.nu)

def main [
    --print (-p) # The zjstatus mode_* lines (the default)
    --layout (-l) # zellij/layout.kdl with the mode_* lines rendered in
] {
    let keybinds = hints keybinds ($ROOT | path join zellij config.kdl)
    if $layout {
        print -n (hints render-layout ($ROOT | path join zellij layout.kdl) $keybinds)
    } else {
        print (hints status-lines $keybinds | str join "\n")
    }
}
