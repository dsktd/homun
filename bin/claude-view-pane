#!/usr/bin/env sh
# Ctrl+Space I: draw the newest image Claude published (`claude-view publish`)
# in a floating pane; n/p step through the others, q closes.
podman exec -it --env TERM "$CLAUDE_CONTAINER" claude-view show latest
status=$?
# The pane closes when this exits; on failure (for example nothing published yet) keep the message on screen.
if [ "$status" -ne 0 ] && [ "$status" -ne 130 ]; then
    echo
    echo "claude-view-pane: exited with $status. Press Enter to close."
    read -r _
fi
exit "$status"
