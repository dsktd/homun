#!/usr/bin/env nu
# Ctrl+Space ?: cheat sheet of every mode's keybinds, derived from
# zellij/config.kdl by lib/hints.nu (the same data as the status bar's hints)

const ROOT = path self | path expand | path dirname | path dirname

use ($ROOT | path join lib hints.nu)

def main [] {
    print " Ctrl+Space enters TMUX mode; the other modes are entered from there.\n"
    print (hints cheat-sheet (hints keybinds ($ROOT | path join zellij config.kdl)) | lines | each { " " + $in } | str join "\n")
    print "\n Detach or quit: Claude keeps running in its container; run the launcher\n again to come back."
    # Only wait for a key when there's a terminal to press one on
    if (is-terminal --stdin) { input "\n Press Enter to close." }
}
