#!/usr/bin/env nu
# Ctrl+Space U: rebuild the image with the latest Claude Code, then recreate
# this session's container with the flags it was launched with (run.nu passes
# them in CLAUDE_WRAPPER_DIR/CLAUDE_WRAPPER_ARGS). The claude pane reattaches
# on its own (see claude-attach).

const ROOT = path self | path expand | path dirname | path dirname

# Run a command, showing and logging its combined output; a non-zero exit is an
# error. The shell hands the exit code back in a file, as nu does not set
# LAST_EXIT_CODE for a command that ends in a pipeline.
def --wrapped step [cmd: string, ...args: string] {
    let code = $"($env.CLAUDE_UPDATE_LOG).code"
    ^sh -c 'f=$1; shift; "$@" 2>&1; echo $? > "$f"' sh $code $cmd ...$args | tee { save -a $env.CLAUDE_UPDATE_LOG } | print
    let rc = open --raw $code | str trim
    rm -f $code
    if $rc != "0" { error make {msg: $"($cmd) exited with ($rc)"} }
}

# [launcher commit, claude version]; the version is "-" when the container does not answer
def state [] {
    # not a git checkout (a Nix store copy): "-", so the state never aborts the update
    let g = try { ^git -C $ROOT rev-parse HEAD | complete } catch { {exit_code: 1, stdout: ""} }
    let rev = if $g.exit_code == 0 { $g.stdout | str trim } else { "-" }
    let v = ^podman exec $env.CLAUDE_CONTAINER claude --version | complete
    [$rev (if $v.exit_code == 0 { $v.stdout | split row " " | first } else { "-" })]
}

def main [] {
    let name = $env.CLAUDE_CONTAINER
    let marker = $env.CLAUDE_WRAPPER_UPDATING
    let launch_args = $env.CLAUDE_WRAPPER_ARGS | from json

    print $"Updating ($name)\n"
    let started_at = date now | format date "%s"
    $"running ($started_at)\n" | save -f $marker
    let dir = $env.CLAUDE_WRAPPER_DIR | path join .services update
    mkdir $dir
    let log = $dir | path join $"update-($started_at).log"
    "" | save -f $log
    $env.CLAUDE_UPDATE_LOG = $log
    let before = state
    let result = try {
        step just -f ($ROOT | path join justfile) update
        cd $env.CLAUDE_WRAPPER_DIR
        step nu ($ROOT | path join run.nu) ...$launch_args --restart-container --detach
        null
    } catch {|err| $err.msg }
    # Keep the last 5 logs; a failure is also recorded for the Manager (container/start.sh)
    ls $dir | where name =~ 'update-\d+\.log$' | sort-by name | drop 5 | each { rm $in.name }
    let failure = $dir | path join last-failure
    if $result == null {
        rm -f $failure  # a stale record of an earlier failure
    } else {
        [$"failed ($started_at) ((date now | format date '%+'))" $result "" ...(open --raw $log | lines | last 40)]
        | str join "\n" | save -f $failure
    }
    $"(if $result == null { "done" } else { "failed" }) ($started_at)\n" | save -f $marker

    if $result != null {
        print $"\n(ansi red_bold)Update failed:(ansi reset) ($result)"
        input "Press Enter to close."
        exit 1
    }
    print $"\n(ansi green_bold)Updated(ansi reset); the claude pane reattaches on its own."
    # What changed, in a floating pane of its own (claude-changelog), only when something did
    let after = state
    let changed = ($before.0 != $after.0) or ($before.1 != "-" and $after.1 != "-" and $before.1 != $after.1)
    if $changed {
        $"($before.0) ($after.0) ($before.1) ($after.1)\n" | save -f $"($marker).changes"
        try { ^zellij run --floating --close-on-exit -- claude-changelog }
    }
    sleep 2sec
}
