#!/usr/bin/env python3
"""claude-lab-session: the dedicated lab session, one nested sway in one window on the user's host display.

  claude-lab-session on [<game command...>]   start it (default: weston-flower, a harmless animated client)
  claude-lab-session off                      stop it
  claude-lab-session status                   running or stopped
  claude-lab-session help
Inside: the lab dashboard (claude-lab-view's app) on the left, a live wl-mirror thumbnail of
the game on the right. The game runs on a second, hidden output (GAME_RES, default 1920x1080)
at its real resolution; wl-mirror scales that output into the thumbnail with screencopy, so
nothing is grabbed periodically. On the Deck the same config runs sway on the real display.
"""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
APP = REPO / "container/lab-view"
PIDFILE = Path("/tmp/claude-lab-session.pid")
CONF = Path("/tmp/claude-lab-session.conf")
RES = os.environ.get("GAME_RES", "1920x1080")
SWAY = (
    REPO / "container/lab-view/sway.nix"
)  # sway with the host window app-id homun-lab-session
GAMES = Path.home() / "claude/.services/locks/games-running"
DEFAULT_GAME = "nix shell nixpkgs#weston -c weston-flower"

CONFIG = """\
default_border none
output * bg #101418 solid_color
workspace 1 output WL-1
workspace 2 output HEADLESS-1
assign [app_id="homun-lab-view"] workspace 1
assign [app_id="at.yrlf.wl_mirror"] workspace 1
for_window [workspace="2"] fullscreen enable
exec_always swaymsg 'create_output; output HEADLESS-1 mode {res} pos 4000 0; output WL-2 unplug'
exec env LAB_VIEW_THUMB=off nix develop path:{app} --command python3 {app}/app.py show
exec sh -c 'sleep 12; nix shell nixpkgs#wl-mirror -c wl-mirror --backend screencopy-shm HEADLESS-1'
exec sh -c 'sleep 3; {game}'
"""


def pid():
    try:
        p = int(PIDFILE.read_text())
        os.kill(p, 0)
        return p
    except (OSError, ValueError):
        return None


def on(game):
    if pid():
        print("claude-lab-session: already running")
        return 0
    busy = subprocess.run([str(GAMES)], capture_output=True, text=True, check=False)
    if busy.returncode != 0:
        print("claude-lab-session: refusing, a game is running\n" + busy.stdout.strip())
        return 1
    sway = subprocess.run(
        ["nix", "build", "--impure", "-f", str(SWAY), "--no-link", "--print-out-paths"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()[0]
    CONF.write_text(
        CONFIG.format(app=APP, res=RES, game=" ".join(game) or DEFAULT_GAME)
    )
    env = dict(
        os.environ,
        WLR_BACKENDS="wayland,headless",
        WLR_WL_OUTPUTS="1",
        WLR_RENDERER="pixman",
    )
    cmd = ["wayland-run", "host", f"{sway}/bin/sway", "-c", str(CONF)]
    with open("/tmp/claude-lab-session.log", "w") as log:
        proc = subprocess.Popen(
            cmd, env=env, stdout=log, stderr=log, start_new_session=True
        )
    PIDFILE.write_text(str(proc.pid))
    time.sleep(1)
    return 0


def main(argv):
    cmd = argv[0] if argv else "help"
    if cmd == "on":
        return on(argv[1:])
    if cmd == "off":
        if pid():
            os.killpg(pid(), signal.SIGTERM)
        PIDFILE.unlink(missing_ok=True)
        return 0
    if cmd == "status":
        print("running" if pid() else "stopped")
        return 0
    print(__doc__)
    return 0 if cmd == "help" else 2


sys.exit(main(sys.argv[1:]))
