#!/usr/bin/env python3
"""Deterministic health check of the Manager container: prints only red findings.

One line per finding, `<check>: <what is wrong>`; nothing when all green; exit 0 either way.
--json prints each finding as a JSON line {"check","msg"}. --notify appends one fixed-template
alarm line to the scheduler events file when there are findings. With --notify (the scheduled form) it also appends
{"ts","findings","checks": {<check>: <count>}} (counts only, no messages) to
mechanic/runs.jsonl under the services dir, trimmed to the last 2000 lines above 1 MB. Paths follow the usual env
overrides (CLAUDE_SERVICES_DIR, SCHEDULER_DIR, MAINT_DB, MECHANIC_ROOT,
MECHANIC_RUNS, MECHANIC_UPTIME, MECHANIC_SERVICES_CMD: "" forces the directory scan, MECHANIC_STATUS_URL:
"" skips the status page check, REGISTRY_DIR, CLAUDE_SCHED_DIR).
"""

import importlib.machinery
import importlib.util
import itertools
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.request

MB = 1024 * 1024
HOUR = 3600


def services_dir():
    return os.environ.get("CLAUDE_SERVICES_DIR") or os.path.expanduser(
        "~/claude/.services"
    )


def scan_services():
    root = services_dir()
    for name in sorted(os.listdir(root) if os.path.isdir(root) else []):
        d = os.path.join(root, name)
        if not os.access(os.path.join(d, "run"), os.X_OK):
            continue
        if os.path.exists(os.path.join(d, "disabled")):
            state = "disabled"
        else:
            state = "stopped"
            try:
                with open(os.path.join(d, "pid")) as f:
                    os.kill(int(f.read().split()[0]), 0)
                state = "running"
            except (OSError, ValueError, IndexError):
                pass
        yield name, state


def listed_services():
    cmd = os.environ.get("MECHANIC_SERVICES_CMD", "claude-services")
    if cmd and shutil.which(cmd):
        out = subprocess.run(
            [cmd, "list"], capture_output=True, text=True, check=True
        ).stdout
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) == 3:
                yield parts[0], parts[2].split()[0]
    else:
        yield from scan_services()


def check_services():
    bad = [n for n, s in listed_services() if s not in ("running", "disabled")]
    return [f"services: not running: {', '.join(bad)}"] if bad else []


def check_status_page():
    url = os.environ.get("MECHANIC_STATUS_URL", "http://127.0.0.1:8421/status.json")
    if not url:
        return []
    try:
        with urllib.request.urlopen(url, timeout=5) as r:
            shown = {x["name"]: x["state"] for x in json.load(r)["services"]}
    except (OSError, ValueError, KeyError, TypeError):
        return ["status: page unreadable"]
    wrong = [n for n, s in listed_services() if n in shown and shown[n] != s]
    return [f"status: page disagrees about: {', '.join(wrong)}"] if wrong else []


def load_registry():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "claude-registry")
    loader = importlib.machinery.SourceFileLoader("claude_registry", path)
    module = importlib.util.module_from_spec(
        importlib.util.spec_from_loader(loader.name, loader)
    )
    loader.exec_module(module)
    return module


def registered_log_paths():
    """The `path:` of every registry log entry, ~ expanded."""
    for ident, info in load_registry().infos().items():
        if ident.startswith("log/"):
            for path in info.get("path", []):
                if path:
                    yield os.path.expanduser(path)


def size_of(path):
    """Bytes of a file, or of the files directly in a directory."""
    if os.path.isdir(path):
        files = [os.path.join(path, n) for n in os.listdir(path)]
        return sum(os.path.getsize(f) for f in files if os.path.isfile(f))
    return os.path.getsize(path) if os.path.isfile(path) else 0


def check_logs():
    root = services_dir()
    paths = [
        os.path.join(root, name, "log")
        for name in sorted(os.listdir(root) if os.path.isdir(root) else [])
    ]
    seen = set()
    out = []
    for p in [*paths, *registered_log_paths()]:
        real = os.path.realpath(p)
        if real in seen:
            continue
        seen.add(real)
        if size_of(p) > 8 * MB:
            label = os.path.relpath(p, root) if p.startswith(root + "/") else p
            out.append(f"logs: {label} is {size_of(p) // MB} MB (over 8)")
    return out


def load_scheduler():
    spec = importlib.util.spec_from_file_location(
        "scheduler_serve",
        os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "container/services/scheduler/serve.py",
        ),
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def last_fires(path):
    """{schedule name: newest fire time} from the scheduler's history.jsonl."""
    fires = {}
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                row = json.loads(line)
                fires[row["name"]] = max(fires.get(row["name"], 0), row["ts"])
    return fires


def check_schedules():
    """Each enabled schedule fired within 1.5 of its longest gap between fires; one never fired counts from its creation (else the table's mtime)."""
    table = os.path.join(
        os.environ.get("CLAUDE_SCHED_DIR") or os.path.join(services_dir(), "sched"),
        "schedules.nuon",
    )
    if not os.path.exists(table):
        return []
    state = os.environ.get("SCHEDULER_DIR") or os.path.join(services_dir(), "scheduler")
    fires = last_fires(os.path.join(state, "history.jsonl"))
    now = time.time()
    out = []
    for entry in load_scheduler().Table(table).load():
        first = entry.cron.next_after(now)
        if not entry.enabled or first is None:
            continue
        upcoming = [first]
        for _ in range(2):
            upcoming.append(entry.cron.next_after(upcoming[-1]) or upcoming[-1])
        period = max(b - a for a, b in itertools.pairwise(upcoming))
        since = fires.get(entry.name) or entry.created or os.path.getmtime(table)
        if now - since > 1.5 * period:
            day = time.strftime("%Y-%m-%d", time.localtime(since))
            out.append(f"schedules: {entry.name} has not fired since {day}")
    return out


def uptime():
    if os.environ.get("MECHANIC_UPTIME"):
        return float(os.environ["MECHANIC_UPTIME"])
    return time.time() - os.stat("/proc/1").st_mtime


def check_usage_lag():
    db = os.environ.get("MAINT_DB") or os.path.join(
        services_dir(), "usage-db", "usage.sqlite"
    )
    if not os.path.exists(db):
        return ["usage-db: usage.sqlite is missing"]
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    try:
        newest = con.execute("select max(ts) from samples").fetchone()[0]
    finally:
        con.close()
    lag = time.time() - (newest or 0)
    if lag > 1800 and uptime() > lag:
        return [f"usage-db: newest sample is {int(lag // 60)} min old (over 30)"]
    return []


def check_maint():
    p = os.path.join(services_dir(), "maint", "hygiene.jsonl")
    if not os.path.exists(p):
        return ["maint: hygiene.jsonl is missing"]
    out = []
    if time.time() - os.path.getmtime(p) > 36 * HOUR:
        out.append("maint: hygiene.jsonl is older than 36 h")
    stale = 0
    with open(p) as f:
        for line in f:
            for wt in json.loads(line).get("worktrees", []):
                if not (wt.get("dirty") or wt.get("merged-by-cherry")):
                    continue
                try:
                    old = time.time() - os.stat(wt["path"]).st_mtime > 7 * 24 * HOUR
                except OSError:
                    old = False
                stale += old
    if stale:
        out.append(f"maint: {stale} dirty or merged worktrees older than 7 days")
    return out


def check_disk():
    s = os.statvfs(os.environ.get("MECHANIC_ROOT") or os.path.expanduser("~/claude"))
    out = []
    if s.f_bavail / s.f_blocks < 0.10:
        out.append(f"disk: only {s.f_bavail * 100 // s.f_blocks}% free (under 10)")
    return out


def check_events():
    state = os.environ.get("SCHEDULER_DIR") or os.path.join(services_dir(), "scheduler")
    p = os.path.join(state, "events")
    if os.path.exists(p) and os.path.getsize(p) > 5 * MB:
        return [
            f"events: scheduler events file is {os.path.getsize(p) // MB} MB (over 5)"
        ]
    return []


CHECKS = [
    check_services,
    check_status_page,
    check_logs,
    check_usage_lag,
    check_maint,
    check_disk,
    check_events,
    check_schedules,
]


def notify(count):
    state = os.environ.get("SCHEDULER_DIR") or os.path.join(services_dir(), "scheduler")
    os.makedirs(state, exist_ok=True)
    msg = f"mechanic: {count} findings; run bin/claude-mechanic"
    with open(os.path.join(state, "events"), "a") as f:
        f.write(json.dumps({"alarm": "mechanic", "msg": msg}) + "\n")


def record_run(findings):
    p = os.environ.get("MECHANIC_RUNS") or os.path.join(
        services_dir(), "mechanic", "runs.jsonl"
    )
    os.makedirs(os.path.dirname(p), exist_ok=True)
    checks = {}
    for line in findings:
        name = line.partition(": ")[0]
        checks[name] = checks.get(name, 0) + 1
    row = {"ts": int(time.time()), "findings": len(findings), "checks": checks}
    with open(p, "a") as f:
        f.write(json.dumps(row) + "\n")
    if os.path.getsize(p) > MB:
        with open(p) as f:
            keep = f.readlines()[-2000:]
        with open(p, "w") as f:
            f.writelines(keep)


def main(argv):
    findings = [line for check in CHECKS for line in check()]
    for line in findings:
        if "--json" in argv:
            name, _, msg = line.partition(": ")
            print(json.dumps({"check": name, "msg": msg}))
        else:
            print(line)
    if "--notify" in argv:
        record_run(findings)
        if findings:
            notify(len(findings))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
