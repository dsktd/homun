#!/usr/bin/env python3
"""Show the role registry (container/roles.json): list, show <key>, doc (markdown, manager/ROLES.md)."""

import json
import os
import sys
from pathlib import Path

REGISTRY = Path(
    os.environ.get("ROLES_FILE")
    or Path(__file__).resolve().parents[1] / "container/roles.json"
)
FIELDS = ("job", "trigger", "model", "may", "never", "reports")


class RolesError(Exception):
    pass


def load():
    try:
        return json.loads(REGISTRY.read_text())
    except (OSError, ValueError) as err:
        raise RolesError(f"cannot read {REGISTRY}: {err}")


def list_table(roles):
    rows = [
        (k, f"{r['emoji']} {r['name']}", r["status"], r["job"])
        for k, r in roles.items()
    ]
    width = [max(len(row[i]) for row in rows) for i in range(3)]
    return "\n".join(
        "  ".join(cell.ljust(w) for cell, w in zip(row, width)) + "  " + row[3]
        for row in rows
    )


def show(roles, key):
    if key not in roles:
        raise RolesError(f"unknown role {key!r}; known: {', '.join(roles)}")
    role = roles[key]
    lines = [f"{role['emoji']} {role['name']} ({key}, {role['status']})"]
    lines += [f"{f}: {role[f]}" for f in FIELDS]
    lines.append("colour: " + ",".join(map(str, role["colour"])))
    return "\n".join(lines)


def doc(roles):
    out = [
        "# Roles",
        "",
        "Generated by `bin/claude-roles doc` from `container/roles.json`; edit the registry, not this file.",
        "A session launched with `--name <key>` shows the role's emoji and colour as its status line nameplate.",
    ]
    for key, role in roles.items():
        out += [
            "",
            f"## {role['emoji']} {role['name']} (`{key}`, {role['status']})",
            "",
        ]
        out += [f"- **{f.capitalize()}:** {role[f]}" for f in FIELDS]
        out.append("- **Colour:** rgb(" + ", ".join(map(str, role["colour"])) + ")")
    return "\n".join(out) + "\n"


def main(argv):
    try:
        roles = load()
        if argv == ["list"]:
            print(list_table(roles))
        elif len(argv) == 2 and argv[0] == "show":
            print(show(roles, argv[1]))
        elif argv == ["doc"]:
            sys.stdout.write(doc(roles))
        else:
            raise RolesError("usage: claude-roles list | show <key> | doc")
    except RolesError as err:
        print(err, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
