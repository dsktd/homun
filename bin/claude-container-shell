#!/usr/bin/env sh
# Zellij's default shell: every new pane/tab is a Nushell inside the session's
# container (CLAUDE_CONTAINER is set by run.nu), not on the host.
# Start in the pane's directory when the container can see it (only ~/claude and
# the user's mounts are visible); otherwise exec fails with 127 on the chdir.
dir=$PWD
podman exec "$CLAUDE_CONTAINER" test -d "$dir" || dir=$HOME/claude
podman exec -it --env TERM --workdir "$dir" "$CLAUDE_CONTAINER" /usr/local/bin/nu
status=$?
# A shell pane closes when this exits, and with it the session if it was the
# last pane; on failure, keep the error on screen instead.
if [ "$status" -ne 0 ] && [ "$status" -ne 130 ]; then
    echo
    echo "claude-container-shell: podman exec into '$CLAUDE_CONTAINER' exited with $status. Press Enter to close."
    read -r _
fi
exit "$status"
