#!/usr/bin/env python3
"""Take a secret the user typed into their Emacs and put it where it belongs, never printing it.

claude-secret list                  names, sizes and ages in the inbox (never contents)
claude-secret take NAME to DEST     copy inbox/NAME to the allowlisted file DEST (0600, temp + rename, old copy kept as .bak)
claude-secret help                  this text
The inbox is /run/claude-secrets (SECRETS_INBOX): The user's Emacs writes it (secret widget in the
transcript), the Manager sees it read-only, no other role sees it. DEST is the allowlist key (or its path);
anything not in ALLOW is refused, so no caller picks a file path. The inbox copy stays (read-only mount)
until the user's next secret overwrites it. Never ask the user to paste a secret in chat; see docs/development.md.
"""

import os
import re
import sys
import time
from pathlib import Path

INBOX = Path(os.environ.get("SECRETS_INBOX") or "/run/claude-secrets")
# slot name -> where `take` may put it (the only place that slot can go)
ALLOW = {
    "dsktd-token": "~/.config/gh/dsktd.token",
    "dotfiles-token": "~/.config/gh/dotfiles.token",
    "desocketed-token": "~/.config/gh/desocketed.token",
    "tangled-app-password": "~/.config/gh/tangled.app-password",
    "mechanic-inbox-token": "~/claude/.services/mechanic/inbox-token",
    "ntfy-token": "~/claude/.services/ntfy/token",
    "ntfy-reply-token": "~/claude/.services/ntfy/reply-token",
}
NAME = re.compile(r"[a-z0-9-]{1,40}")


class SecretError(Exception):
    pass


def slot(name):
    if not NAME.fullmatch(name or ""):
        raise SecretError("name must be [a-z0-9-]{1,40}")
    file = INBOX / name
    if not file.is_file():
        raise SecretError(f"nothing in the inbox for {name}")
    return file


def target(name, dest):
    if name not in ALLOW:
        raise SecretError(f"{name} has no allowed destination")
    want = os.path.abspath(os.path.expanduser(ALLOW[name]))
    if dest != name and os.path.abspath(os.path.expanduser(dest)) != want:
        raise SecretError(f"{name} may only go to {name} ({ALLOW[name]})")
    return Path(want)


def take(name, dest):
    file = slot(name)
    out = target(name, dest)
    data = file.read_bytes()
    out.parent.mkdir(parents=True, exist_ok=True)
    if out.exists():
        bak = out.with_name(out.name + ".bak")
        fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(out.read_bytes())
    temp = out.with_name(f".{out.name}.tmp{os.getpid()}")
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(temp, out)
    finally:
        if temp.exists():
            temp.unlink()
    print(f"saved {name} to {out} ({len(data)} bytes)")


def list_():
    if not INBOX.is_dir():
        raise SecretError(f"no inbox at {INBOX}")
    for f in sorted(INBOX.iterdir()):
        if f.is_file() and NAME.fullmatch(f.name):
            st = f.stat()
            print(
                f"{f.name}  {st.st_size} bytes  {int(time.time() - st.st_mtime)}s old"
            )


def main(argv):
    try:
        match argv:
            case ["list"]:
                list_()
            case ["take", name, "to", dest]:
                take(name, dest)
            case ["help"] | []:
                print(__doc__.strip())
            case _:
                raise SecretError(
                    "usage: claude-secret list | take NAME to DEST | help"
                )
    except (SecretError, OSError) as err:
        print(f"claude-secret: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
