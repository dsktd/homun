#!/usr/bin/env sh
# Ctrl+Space I: open the newest published image in a floating pane just big enough for it.
# Runs in a borderless full-screen floating pane (see zellij/config.kdl), so `stty size` is the
# terminal's size; it asks the terminal for its cell size in pixels (CSI 16 t, 200 ms) and lets
# `claude-view fit` in the container do the arithmetic. On any failure it opens the plain viewer.
fallback() {
    echo "claude-view-open: $1; opening the default pane" >&2
    exec zellij run --floating --close-on-exit --name view -- claude-view-pane
}

# Cell size in pixels as "<w> <h>", or nothing when the terminal does not answer.
cell_px() {
    saved=$(stty -g) || return 0
    stty raw -echo min 0 time 2
    printf '\033[16t' >/dev/tty
    reply=$(dd bs=32 count=1 2>/dev/null | tr -d '\033')
    stty "$saved"
    # reply: [6;<height>;<width>t
    case $reply in
    '[6;'*t) echo "$reply" | sed 's/^\[6;\([0-9]*\);\([0-9]*\)t.*/\2 \1/' ;;
    esac
}

size=$(podman exec "$CLAUDE_CONTAINER" claude-view size latest) || fallback "no image size"
term=$(stty size) || fallback "no terminal size"
cells=$(cell_px)
# shellcheck disable=SC2086 # the words are numbers
fitted=$(podman exec "$CLAUDE_CONTAINER" claude-view fit $size "${term#* }" "${term% *}" $cells) || fallback "no fit"
# shellcheck disable=SC2086
set -- $fitted
cols=$1
rows=$2
# +2 for the pane frame, +2 rows for the caption under the image
width=$((cols + 2))
height=$((rows + 4))
x=$(((${term#* } - width) / 2))
y=$(((${term% *} - height) / 2))
exec zellij run --floating --close-on-exit --name view --width "$width" --height "$height" -x "$x" -y "$y" -- claude-view-pane
