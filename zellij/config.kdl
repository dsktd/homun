// Host-side Zellij for homun sessions. run.nu sets CLAUDE_CONTAINER
// to the session's container before starting Zellij, so every pane inherits it.

// Sessions are tied to a running container; don't resurrect stale ones.
session_serialization false
show_startup_tips false
show_release_notes false

// Open sessions in a browser at http://127.0.0.1:8082 (log in with a token from
// `zellij web --create-token`). Local only unless web_server_ip is changed.
web_server true
web_sharing "on"

// Vim-like and modal: "locked" is insert mode (every key goes to Claude or the
// shell), Ctrl+Space enters a normal mode ("tmux") for driving Zellij, and
// Esc/i/Ctrl+Space go back.
default_mode "locked"

// On PATH via run.nu
default_shell "claude-container-shell"

// Scroll mode, e: the pane's scrollback in the host's Emacs (bin/claude-scrollback-edit)
scrollback_editor "claude-scrollback-edit"

keybinds clear-defaults=true {
    locked {
        bind "Ctrl Space" { SwitchToMode "tmux"; }
        // Alacritty's vi-mode key: the pane's scrollback in the host's Emacs (as scroll mode e)
        bind "Ctrl Shift Space" { EditScrollback; }
        // C-c is swapped off so a stray press can't interrupt Claude's work: it flashes a 50 ms hint instead; M-c sends ESC c then the real ^C (session-view takes the ESC c as its way back to terminal mode and ignores ^C; the Claude TUI sees the ^C)
        bind "Ctrl c" {
            Run "sh" "-c" "printf ' C-c is off - M-c interrupts'; sleep 0.05" {
                floating true; close_on_exit true; name "hint"
                x "65%"; y "88%"; width "34%"; height 3
            }
        }
        bind "Alt c" { Write 27 99 3; }
    }

    tmux {
        bind "Esc" "i" "Ctrl Space" { SwitchToMode "locked"; }

        // New panes and tabs are shells inside the container (see default_shell)
        bind "c" { NewPane; SwitchToMode "locked"; }
        bind "s" { NewPane "Down"; SwitchToMode "locked"; }
        bind "v" { NewPane "Right"; SwitchToMode "locked"; }

        // Panes; movement stays in normal mode so it can be repeated
        bind "h" { MoveFocus "Left"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "l" { MoveFocus "Right"; }
        bind "H" { MovePane "Left"; }
        bind "J" { MovePane "Down"; }
        bind "K" { MovePane "Up"; }
        bind "L" { MovePane "Right"; }
        // x asks first (pane mode below): the standing tabs' panes must not go by one stray key
        bind "x" { SwitchToMode "pane"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        // Float or embed the focused pane (C-SPC f then hides or shows every floating pane), or break it out into a tab of its own
        bind "F" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "R" { SwitchToMode "renamepane"; PaneNameInput 0; }

        // Tabs
        bind "t" { NewTab; SwitchToMode "locked"; }
        bind "n" { GoToNextTab; }
        bind "p" { GoToPreviousTab; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "T" { SwitchToMode "renametab"; TabNameInput 0; }

        // Sub-modes
        bind "r" { SwitchToMode "resize"; }
        bind "[" { SwitchToMode "scroll"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }

        // Session. Detaching or quitting leaves Claude running in its container.
        // U shows the image state in a floating pane (bin/claude-update show); a home-manager switch updates.
        bind "d" { Detach; }
        // q asks first (bin/claude-quit-confirm): y ends the session, anything else keeps it
        bind "q" {
            Run "claude-quit-confirm" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "locked";
        }
        bind "U" {
            Run "claude-pane-log" "update" "claude-update" "show" { floating true; close_on_exit false; }
            SwitchToMode "locked";
        }
        // g: what the last update changed, in a pager (bin/claude-changelog)
        bind "g" {
            Run "claude-pane-log" "changelog" "claude-changelog" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
        // A quick side question (like /btw) over the top of the tab, with the focused session as background (bin/claude-btw-pane)
        bind "?" {
            Run "claude-btw-pane" { floating true; close_on_exit true; x "0%"; y "0%"; width "100%"; height "40%"; }
            SwitchToMode "locked";
        }
        // A frame of Claude's Emacs (the emacs service) on this display: `homun emacs`
        bind "e" {
            Run "claude-emacs" "frame" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
        // The newest image Claude sent, shown again by the host handler (bin/claude-view-last)
        bind "I" {
            Run "claude-view-last" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
        // C-SPC TAB TAB: pick a tab by name (tab mode below)
        bind "Tab" { SwitchToMode "tab"; }
        // A tab with a project session of Claude in a workspace: asks which (`homun tab add`)
        bind "P" {
            Run "claude-project-tab-prompt" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
    }

    // The confirmation of C-SPC x: y closes the focused pane, any other key keeps it
    pane {
        bind "y" { CloseFocus; SwitchToMode "locked"; }
        bind "Esc" "n" "Enter" "Ctrl Space" { SwitchToMode "locked"; }
    }

    resize {
        bind "Esc" "Enter" "Ctrl Space" { SwitchToMode "locked"; }
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    scroll {
        bind "Esc" "q" "Ctrl Space" { ScrollToBottom; SwitchToMode "locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "g" { ScrollToTop; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
    }

    entersearch {
        bind "Esc" "Ctrl Space" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }

    search {
        bind "Esc" "q" "Ctrl Space" { ScrollToBottom; SwitchToMode "locked"; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    tab {
        bind "Esc" "i" { SwitchToMode "locked"; }
        // Pick a tab by name, fuzzy (bin/claude-tab-pick)
        bind "Tab" {
            Run "claude-tab-pick" { floating true; close_on_exit true; }
            SwitchToMode "locked";
        }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "locked"; }
        bind "Enter" { SwitchToMode "locked"; }
    }

    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "locked"; }
        bind "Enter" { SwitchToMode "locked"; }
    }
}
