;;; homun-stage-live-test.el --- ERT for live rows, transitions and sparklines -*- lexical-binding: t -*-
(require 'ert)
(require 'homun-stage-live)
(require 'homun-stage-store)

(defvar homun-stage-live-test--now 1000.0)

(defmacro homun-stage-live-test--with (rows &rest body)
  "Run BODY with a scene \"sc\" that draws ROWS (a form) through `homun-stage-live-draw-row`, on a fake clock."
  (declare (indent 1))
  `(let* ((homun-stage-dir (file-name-as-directory (make-temp-file "stage" t)))
          (homun-stage-scenes (make-hash-table :test #'equal))
          (homun-stage-live-test--now 1000.0)
          (homun-clock-time-function (lambda () homun-stage-live-test--now))
          (homun-clock--clients nil) (homun-clock--periods nil) (homun-clock--timer nil)
          (homun-clock--wanted nil) (homun-clock-focused-function (lambda () t))
          (homun-stage-live-scenes '("sc"))
          (homun-stage-render-functions
           (append homun-stage-render-functions
                   (list (lambda (s)
                           (when (equal (homun-stage-scene-id s) "sc")
                             (goto-char (point-max))
                             (let ((specs ,rows))
                               (dolist (spec specs) (homun-stage-live-draw-row spec) (insert "\n"))
                               (homun-stage-live-prune (mapcar #'car specs))))))))
          (homun-stage-live-spark-sources '((k "load" (lambda () (list '(1 2 3) 3 "3")))))
          (homun-stage-live--spark-cache nil) (homun-stage-live--buffers nil)
          (homun-stage-live-visible-function (lambda (_) t)))
     (unwind-protect
         (let ((s (homun-stage-show "t" "sc" "Sc" '((type . "text") (text . "hi")) "ephemeral")))
           (ignore s) ,@body)
       (homun-clock--stop)
       (dolist (b (buffer-list)) (when (string-prefix-p "*stage " (buffer-name b)) (kill-buffer b)))
       (delete-directory homun-stage-dir t))))

(defun homun-stage-live-test--buf () (get-buffer (homun-stage-buffer-name "sc")))
(defun homun-stage-live-test--tick (dt &optional snap)
  (cl-incf homun-stage-live-test--now dt)
  (with-current-buffer (homun-stage-live-test--buf) (homun-stage-live--tick snap)))
(defun homun-stage-live-test--text () (with-current-buffer (homun-stage-live-test--buf) (buffer-string)))

(ert-deftest homun-stage-live-pure ()
  (should (equal (homun-stage-live-elapsed 83) " 1m23s"))
  (should (= 6 (length (homun-stage-live-elapsed 4))))
  (should (equal (homun-stage-live-glyphs '(0 5 10 nil) 10) "▁▃▇ "))
  (should (= 15 (length (homun-stage-live-bar 0.4))))
  (should (= 15 (length (homun-stage-live-bar nil))))
  (should (equal (homun-stage-live-spinner 0.0) (aref widgetry-spinner-frames 0))))

(ert-deftest homun-stage-live-spinner-and-time-turn ()
  (homun-stage-live-test--with '(("a" "Build it" "running" 1000.0 0.5))
    (should (string-match-p "Build it" (homun-stage-live-test--text)))
    (should (string-match-p "50%" (homun-stage-live-test--text)))
    (homun-stage-live-test--tick 65.0)
    (should (string-match-p "1m05s" (homun-stage-live-test--text)))
    (should (string-match-p "Build it" (homun-stage-live-test--text)))))

(ert-deftest homun-stage-live-only-changed-spans ()
  (homun-stage-live-test--with '(("a" "Build it" "running" 1000.0 nil))
    (homun-stage-live-test--tick 1.0)
    (let ((tick (buffer-chars-modified-tick))) (ignore tick))
    (with-current-buffer (homun-stage-live-test--buf)
      (let ((before (buffer-size)) (n 0))
        (add-hook 'after-change-functions (lambda (&rest _) (cl-incf n)) nil t)
        (setq-local inhibit-modification-hooks nil)
        (homun-stage-live-test--tick 0.0)
        (should (= n 0))                ; nothing changed: no edit at all
        (should (= before (buffer-size)))))))

(ert-deftest homun-stage-live-fades-in-then-settles ()
  (homun-stage-live-test--with '(("a" "Build it" "running" 1000.0 nil))
    (with-current-buffer (homun-stage-live-test--buf)
      (let ((st (gethash "a" homun-stage-live--rows)))
        (should (homun-stage-live-row-fade-ov st))
        (homun-stage-live-test--tick 0.05)
        (should (< (homun-stage-live-row-fade st) 6))
        (homun-stage-live-test--tick 0.3)
        (should (= 6 (homun-stage-live-row-fade st)))
        (should-not (homun-stage-live-row-fade-ov st))))))

(ert-deftest homun-stage-live-flashes-check-then-settles ()
  (let ((state "running"))
    (homun-stage-live-test--with (list (list "a" "Build it" state 1000.0 nil))
      (setq state "done")
      (homun-stage-render (homun-stage-scene "sc"))
      (with-current-buffer (homun-stage-live-test--buf)
        (let ((st (gethash "a" homun-stage-live--rows)))
          (should (string-match-p "✓" (buffer-string)))
          (should (eq 'homun-stage-live-flash (get-text-property (marker-position (homun-stage-live-row-beg-spin st)) 'face)))
          (should (homun-stage-live-test--tick 0.5))
          (homun-stage-live-test--tick 1.0)
          (should (eq 'success (get-text-property (marker-position (homun-stage-live-row-beg-spin st)) 'face)))
          (should-not (homun-stage-live-test--tick 0.5))
          (should-not homun-stage-live--active))))))

(ert-deftest homun-stage-live-sparks-fall-back-to-glyphs ()
  (homun-stage-live-test--with nil
    (setq homun-stage-live--spark-cache nil)
    (homun-stage-live--refresh-sparks)
    (with-current-buffer (homun-stage-live-test--buf)
      (should (string-match-p "▂▅▇" (buffer-string)))
      (should (string-match-p "load" (buffer-string))))))

(ert-deftest homun-stage-live-pauses-when-hidden ()
  (homun-stage-live-test--with '(("a" "Build it" "running" 1000.0 nil))
    (setq homun-stage-live-visible-function (lambda (_) nil))
    (should-not (homun-stage-live-test--tick 1.0))))
