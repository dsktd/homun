;;; claude-remote-live-test.el --- ERT for opt-in live reload -*- lexical-binding: t -*-
;; emacs --batch -L container/emacs -l tests/el/claude-remote-live-test.el -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'claude-remote-live)

(defun claude-remote-live-test--reply (content &optional sha)
  (cons 200 (list :file "x.el" :content content
                  :sha256 (or sha (secure-hash 'sha256 (encode-coding-string content 'utf-8))))))

(ert-deftest claude-remote-live-is-off-while-disconnected ()
  (let ((claude-remote-connected nil) (fetched nil))
    (cl-letf (((symbol-function 'claude-remote--request) (lambda (&rest _) (setq fetched t))))
      (claude-remote-live--record "reload" "x.el" '(:file "x.el" :sha256 "a")))
    (should-not fetched)
    (should-not (claude-remote-live-active-p))))

(ert-deftest claude-remote-live-checks-the-hash-and-never-writes ()
  (let* ((claude-remote-connected t) (default-directory (make-temp-file "d" t))
         (files-before (directory-files default-directory)))
    (setq claude-remote-live-test--v 0)
    (claude-remote-live--apply (claude-remote-live-test--reply "(setq claude-remote-live-test--v 1)" "bad") "x.el" "bad")
    (should (= claude-remote-live-test--v 0))               ; hash does not match the content
    (let* ((c "(setq claude-remote-live-test--v 2)") (sha (secure-hash 'sha256 c)))
      (claude-remote-live--apply (claude-remote-live-test--reply c sha) "x.el" sha)
      (should (= claude-remote-live-test--v 2))
      (claude-remote-live--apply (claude-remote-live-test--reply c sha) "x.el" "other") ; hash differs from the record's
      (should (= claude-remote-live-test--v 2)))
    (should (equal files-before (directory-files default-directory)))))
(defvar claude-remote-live-test--v 0)

(ert-deftest claude-remote-live-refuses-odd-names-and-ends ()
  (let ((claude-remote-connected t) (asked nil))
    (cl-letf (((symbol-function 'claude-remote--request) (lambda (&rest _) (setq asked t))))
      (claude-remote-live--record "reload" "../x.el" '(:file "../x.el" :sha256 "a"))
      (should-not asked)
      (claude-remote-live--record "reload" "x.el" '(:file "x.el" :sha256 "a"))
      (should asked))))

(ert-deftest claude-remote-live-rearms-on-connect-without-expiry ()
  (let ((claude-remote-connected t) asked)
    (should (memq #'claude-remote-live-start claude-remote-connected-hook))
    (cl-letf (((symbol-function 'claude-remote--request) (lambda (_m path &rest _) (push path asked))))
      (claude-remote-live-start))
    (should (equal asked '("reload")))
    (should (claude-remote-live-active-p))))

(ert-deftest claude-remote-live-failure-is-reported-with-a-backtrace ()
  (let ((claude-remote-connected t) reported (debugger (lambda (&rest _) (error "debugger opened"))))
    (cl-letf (((symbol-function 'claude-remote-report-error) (lambda (err bt) (setq reported (cons err bt)))))
      (let* ((c "(error \"boom\")") (sha (secure-hash 'sha256 c)))
        (should-not (claude-remote-live--apply (claude-remote-live-test--reply c sha) "x.el" sha))))
    (should (equal (cadr (car reported)) "boom"))
    (should (stringp (cdr reported)))))

(defvar homun-dir)
(ert-deftest claude-remote-live-turning-on-catches-up-and-says-the-version ()
  (let* ((homun-dir (file-name-as-directory (make-temp-file "h" t)))
         (old "(setq claude-remote-live-test--v 3)") (new "(setq claude-remote-live-test--v 4)")
         (sha (lambda (c) (secure-hash 'sha256 (encode-coding-string c 'utf-8))))
         (claude-remote-connected t) (claude-remote-live--loaded nil)
         said asked)
    (with-temp-file (expand-file-name "same.el" homun-dir) (insert old))
    (with-temp-file (expand-file-name "x.el" homun-dir) (insert old))
    (cl-letf (((symbol-function 'claude-remote-live--say) (lambda (text) (setq said text)))
              ((symbol-function 'claude-remote--request)
               (lambda (_m path _b cb)
                 (push path asked)
                 (funcall cb (cons 200 (list :file "x.el" :sha256 (funcall sha new) :content new))))))
      (claude-remote-live--catch-up
       (cons 200 (list :version "abcd1234"
                       :files (list :same.el (funcall sha old) :x.el (funcall sha new)
                                   :init.el (funcall sha "(desktop config)")))))  ; never fetched here: not run
      (should (equal asked '("reload?file=x.el")))
      (should (= claude-remote-live-test--v 4))
      (should (string-match-p "auto-update homun abcd1234: loaded 1 of 1 (x.el)" said))
      (setq asked nil)
      (claude-remote-live--catch-up
       (cons 200 (list :version "abcd1234" :files (list :x.el (funcall sha new)))))
      (should-not asked)
      (should (string-match-p "auto-update homun abcd1234: up to date" said)))))

(ert-deftest claude-remote-live-new-required-file-in-the-same-batch ()
  "A is listed first and requires the new B: no error, both loaded, B once."
  (let* ((homun-dir (file-name-as-directory (make-temp-file "h" t)))
         (a "(require 'crl-test-b)\n(setq crl-test-a crl-test-b-value)\n(provide 'crl-test-a)")
         (b "(defvar crl-test-b-value 7)\n(setq crl-test-b-count (1+ (or (bound-and-true-p crl-test-b-count) 0)))\n(provide 'crl-test-b)")
         (sha (lambda (c) (secure-hash 'sha256 (encode-coding-string c 'utf-8))))
         (claude-remote-connected t) (claude-remote-live--loaded nil) said)
    (defvar crl-test-a nil) (defvar crl-test-b-count 0)
    (with-temp-file (expand-file-name "crl-test-a.el" homun-dir) (insert "(setq crl-test-a 0)"))
    (cl-letf (((symbol-function 'claude-remote-live--say) (lambda (text) (setq said text)))
              ((symbol-function 'claude-remote--request)
               (lambda (_m path _b cb)
                 (let ((name (substring path (length "reload?file="))))
                   (funcall cb (cons 200 (list :file name :sha256 (funcall sha (if (equal name "crl-test-a.el") a b))
                                               :content (if (equal name "crl-test-a.el") a b))))))))
      (claude-remote-live--catch-up
       (cons 200 (list :version "v" :files (list :crl-test-a.el (funcall sha a) :crl-test-b.el (funcall sha b)))))
      (should (string-match-p "loaded 2 of 2" said))
      (should (= crl-test-a 7))
      (should (= crl-test-b-count 1)))))

(ert-deftest claude-remote-live-one-failed-fetch-loads-nothing ()
  (let* ((homun-dir (file-name-as-directory (make-temp-file "h" t)))
         (c "(setq claude-remote-live-test--v 99)") (sha (secure-hash 'sha256 c))
         (claude-remote-connected t) (claude-remote-live--loaded nil) said)
    (setq claude-remote-live-test--v 0)
    (cl-letf (((symbol-function 'claude-remote-live--say) (lambda (text) (setq said text)))
              ((symbol-function 'claude-remote--request)
               (lambda (_m path _b cb)
                 (funcall cb (if (string-match-p "bad" path) '(500)
                               (cons 200 (list :file "good.el" :sha256 sha :content c)))))))
      (claude-remote-live--catch-up (cons 200 (list :version "v" :files (list :good.el sha :bad.el "x"))))
      (should (= claude-remote-live-test--v 0))
      (should (string-match-p "loaded 0 of 2" said))
      (should-not (file-exists-p (expand-file-name "good.el" homun-dir))))))

(ert-deftest claude-remote-live-one-unparsable-file-loads-nothing ()
  (let* ((homun-dir (file-name-as-directory (make-temp-file "h" t)))
         (c "(setq claude-remote-live-test--v 99)") (b "(setq claude-remote-live-test--v 1")
         (claude-remote-connected t) (claude-remote-live--loaded nil) said)
    (setq claude-remote-live-test--v 0)
    (cl-letf (((symbol-function 'claude-remote-live--say) (lambda (text) (setq said text)))
              ((symbol-function 'claude-remote--request)
               (lambda (_m path _b cb)
                 (let ((x (if (string-match-p "bad" path) b c)))
                   (funcall cb (cons 200 (list :file (if (string-match-p "bad" path) "bad.el" "good.el")
                                               :sha256 (secure-hash 'sha256 (encode-coding-string x 'utf-8))
                                               :content x)))))))
      (claude-remote-live--catch-up
       (cons 200 (list :version "v" :files (list :good.el (secure-hash 'sha256 (encode-coding-string c 'utf-8))
                                                 :bad.el (secure-hash 'sha256 (encode-coding-string b 'utf-8))))))
      (should (= claude-remote-live-test--v 0))
      (should (string-match-p "loaded 0 of 2.*bad.el line" said))
      (should-not (file-exists-p (expand-file-name "good.el" homun-dir))))))
