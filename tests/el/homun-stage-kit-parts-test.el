;;; homun-stage-kit-parts-test.el --- ERT for the extra stage kit parts -*- lexical-binding: t -*-
;; emacs --batch -L container/emacs -L container/emacs/widgetry -l tests/el/homun-stage-kit-parts-test.el -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'homun-stage-kit-parts)
(require 'homun-stage-project)

(defmacro homun-stage-kit-parts-test--with (&rest body)
  (declare (indent 0))
  `(let ((homun-stage-kit--data (make-hash-table :test #'equal))
         (homun-clock-time-function (lambda () 1000.0)))
     (cl-letf (((symbol-function 'homun-stage-kit--wake) #'ignore)) ,@body)))

(defun homun-stage-kit-parts-test--text (node)
  (homun-stage-kit--text node))

(defun homun-stage-kit-parts-test--tmp (text)
  (let ((f (make-temp-file "kitp"))) (with-temp-file f (insert text)) f))

(ert-deftest homun-stage-kit-prs-parse-and-draw ()
  (homun-stage-kit-parts-test--with
    (let* ((json "[{\"number\":230,\"title\":\"b\",\"url\":\"u230\",\"state\":\"OPEN\",\"additions\":5,\"deletions\":2,\"statusCheckRollup\":[{\"conclusion\":\"SUCCESS\",\"status\":\"COMPLETED\"},{\"conclusion\":\"\",\"status\":\"IN_PROGRESS\"}]},{\"number\":216,\"title\":\"a\",\"url\":\"u216\",\"state\":\"OPEN\",\"additions\":1,\"deletions\":0,\"statusCheckRollup\":[]},{\"number\":1,\"title\":\"x\",\"url\":\"u1\",\"state\":\"OPEN\",\"additions\":0,\"deletions\":0}]")
           (prs (homun-stage-kit--prs-parse json '(216 230)))
           (node '((type . "prs") (repo . "o/r") (max . 3) (width . 40))))
      (should (equal (mapcar #'car prs) '(216 230)))
      (should (eq (nth 3 (cadr prs)) 'pending))
      (should (eq (homun-stage-kit--ci '(((conclusion . "FAILURE")))) 'fail))
      (homun-stage-kit-put (homun-stage-kit--prs-key node) (list :prs prs :at 0.0))
      (let* ((text (homun-stage-kit-parts-test--text node)) (lines (split-string text "\n")))
        (should (= 4 (length lines)))
        (should (string-match-p "#216" (nth 1 lines)))
        (should (string-match-p "+5 −2" (nth 2 lines)))
        (should (equal text (homun-stage-kit-parts-test--text node)))
        (should (equal '(url "u216") (get-text-property 1 'homun-kit-open (nth 1 lines))))
        (should (eq 'touch (car (get-text-property (1- (length (car lines))) 'homun-kit-open (car lines)))))))))

(ert-deftest homun-stage-kit-prs-failure-keeps-old ()
  (homun-stage-kit-parts-test--with
    (let ((node '((type . "prs") (repo . "o/r") (width . 40))))
      (homun-stage-kit-put (homun-stage-kit--prs-key node) (list :error "waiting for the manager" :prs '((7 "t" "u" pass 1 1 "OPEN"))))
      (let ((text (homun-stage-kit-parts-test--text node)))
        (should (string-match-p "failed: waiting for the manager" text))
        (should (string-match-p "#7" text))))))

(ert-deftest homun-stage-kit-log-file-and-tests ()
  (homun-stage-kit-parts-test--with
    (let* ((f (homun-stage-kit-parts-test--tmp "\e[2mnoise\e[0m periodic_stun\nreal line\ntest result: ok. 7 passed; 1 failed; 0 ignored\n"))
           (node `((type . "log") (file . ,f) (skip . "periodic_stun") (lines . 2) (width . 40)))
           (key (homun-stage-kit--build-key node)))
      (homun-stage-kit--build-source node key)
      (let ((d (homun-stage-kit-get key)))
        (should (= 7 (plist-get d :pass))) (should (= 1 (plist-get d :fail)))
        (should (equal (plist-get d :lines) '("real line" "test result: ok. 7 passed; 1 failed; 0 ignored")))
        (should (equal (homun-stage-kit--build-target d) (list 'file f)))
        (let ((again (homun-stage-kit--file-data f (plist-get d :stamp) nil d))) (should (eq again d))))
      (should (string-match-p "real line" (homun-stage-kit-parts-test--text node)))
      (let ((tn `((type . "tests") (file . ,f) (width . 40))))
        (homun-stage-kit--build-source tn (homun-stage-kit--build-key tn))
        (should (string-match-p "✓ 7" (homun-stage-kit-parts-test--text tn)))))))

(ert-deftest homun-stage-kit-latest-log ()
  (homun-stage-kit-parts-test--with
    (let* ((dir (file-name-as-directory (make-temp-file "bl" t)))
           (build (expand-file-name "a.log" dir)) (tst (expand-file-name "b.log" dir)))
      (with-temp-file build (insert "building\n"))
      (with-temp-file tst (insert "test result: ok. 3 passed; 0 failed\n"))
      (with-temp-file (expand-file-name "latest.json" dir)
        (insert (format "{\"command\":\"cargo build\",\"exit\":101,\"seconds\":2.5,\"log\":%S}" build)))
      (should (equal build (homun-stage-kit--latest dir "log")))
      (should (equal tst (homun-stage-kit--latest dir "tests"))))))

(ert-deftest homun-stage-kit-buildstat ()
  (homun-stage-kit-parts-test--with
    (let* ((dir (file-name-as-directory (make-temp-file "bl" t)))
           (log (expand-file-name "a.log" dir))
           (node `((type . "buildstat") (latest . ,dir) (width . 60))))
      (should (string-match-p "none yet" (homun-stage-kit-parts-test--text node)))
      (with-temp-file log (insert "\e[31merror[E0425]: cannot find x\e[0m\nmore\n"))
      (with-temp-file (expand-file-name "latest.json" dir)
        (insert (format "{\"command\":\"cargo build\",\"exit\":101,\"seconds\":2.5,\"log\":%S}" log)))
      (homun-stage-kit--buildstat-source node (list "buildstat" dir))
      (let ((text (homun-stage-kit-parts-test--text node)))
        (should (string-match-p "✗ fail 101" text)) (should (string-match-p "2.5s" text))
        (should (string-match-p "error\\[E0425\\]: cannot find x" text)))
      (with-temp-file (expand-file-name "latest.json" dir)
        (insert (format "{\"command\":\"cargo test\",\"exit\":0,\"seconds\":9,\"log\":%S}" log)))
      (homun-stage-kit--buildstat-source node (list "buildstat" dir))
      (should (string-match-p "✓ pass" (homun-stage-kit-parts-test--text node))))))

(ert-deftest homun-stage-kit-players ()
  (homun-stage-kit-parts-test--with
    (let* ((f (homun-stage-kit-parts-test--tmp "x summary sessions=2 matches=1\nnoise\nx summary sessions=3 matches=1\n"))
           (node `((type . "players") (file . ,f) (width . 60))))
      (homun-stage-kit--players-source node (list "players" f))
      (let ((text (homun-stage-kit-parts-test--text node)))
        (should (string-match-p "3 connected" text))
        (should (string-match-p "names no players" text)))
      (should (null (progn (delete-file f) (homun-stage-kit--players-source node (list "players" f))
                           (homun-stage-kit-get (list "players" f))))))))

(ert-deftest homun-stage-kit-checklist ()
  (homun-stage-kit-parts-test--with
    (let* ((node '((type . "checklist") (label . "ms") (width . 30)
                   (items . (((text . "M0") (state . "done") (open . "/f") (line . 3)) ((text . "M2") (state . "now"))))))
           (lines (split-string (homun-stage-kit-parts-test--text node) "\n")))
      (should (string-match-p "✓ M0" (nth 1 lines)))
      (should (string-match-p "▸ M2" (nth 2 lines)))
      (should (equal '(file "/f" 3) (get-text-property 1 'homun-kit-open (nth 1 lines))))
      (should (null (get-text-property 1 'homun-kit-open (nth 2 lines)))))))

(ert-deftest homun-stage-kit-section ()
  (homun-stage-kit-parts-test--with
    (let* ((f (homun-stage-kit-parts-test--tmp "# T\n## 4. Other\n- no\n## 5. Open questions\n\n1. **Concept:** a\n2. second\n## 6. After\n- no\n"))
           (node `((type . "section") (file . ,f) (heading . "^## 5\\.") (max . 3) (width . 30)))
           (key (list "section" f "^## 5\\.")))
      (homun-stage-kit--section-source node key)
      (let ((lines (split-string (homun-stage-kit-parts-test--text node) "\n")))
        (should (= 4 (length lines)))
        (should (string-match-p "5. Open questions" (nth 0 lines)))
        (should (string-match-p "Concept: a" (nth 1 lines)))
        (should (equal (list 'file f 6) (get-text-property 1 'homun-kit-open (nth 1 lines))))
        (should (equal (list 'file f 4) (get-text-property 1 'homun-kit-open (nth 0 lines))))))))

(ert-deftest homun-stage-kit-ron-and-layout ()
  (let* ((ron "Split(axis:Horizontal, ratio:0.25, first:Area(Term), second:Split(axis:Vertical,ratio:0.5,first:Area(2),second:Area(3)),)")
         (tree (homun-stage-kit--layout-tree ron)))
    (should (equal (car tree) 'split))
    (let ((rects (homun-stage-kit--layout-rects tree 0 0 100 100)))
      (should (equal (mapcar #'car rects) '("Term" "2" "3")))
      (should (equal (cdr (car rects)) '(0 0 25.0 100)))
      (should (equal (cdr (nth 2 rects)) '(25.0 50.0 75.0 50.0))))
    (let ((svg (homun-stage-kit--layout-svg tree 200 100)))
      (should (= 3 (length (dom-by-tag svg 'rect)))))
    (should (= 5 (length (homun-stage-kit--layout-text tree))))
    (should-error (homun-stage-kit--layout-tree "Foo(1)"))))

(ert-deftest homun-stage-kit-layout-part-text ()
  (homun-stage-kit-parts-test--with
    (let* ((node '((type . "layout") (rows . 5) (width . 30) (open . "/f") (line . 2)
                   (ron . "Split(axis:Horizontal,ratio:0.5,first:Area(1),second:Area(2))")))
           (lines (split-string (homun-stage-kit-parts-test--text node) "\n")))
      (should (= 5 (length lines)))
      (should (string-match-p "side by side" (car lines)))
      (should (equal '(file "/f" 2) (get-text-property 1 'homun-kit-open (car lines)))))
    (should (string-match-p "no layout file" (homun-stage-kit-parts-test--text '((type . "layout") (file . "/nonexistent") (rows . 2)))))))

(ert-deftest homun-stage-kit-cycle ()
  (homun-stage-kit-parts-test--with
    (let* ((steps '(((label . "day") (sub . "a") (open . "/d") (line . 13)) ((label . "dusk")) ((label . "night"))))
           (svg (homun-stage-kit--cycle-svg (mapcar (lambda (s) (list (alist-get 'label s) (alist-get 'sub s))) steps) 400 200)))
      (should (= 3 (length (dom-by-tag svg 'rect))))
      (should (= 3 (length (dom-by-tag svg 'polygon))))
      (let* ((node `((type . "cycle") (rows . 4) (width . 50) (steps . ,steps)))
             (lines (split-string (homun-stage-kit-parts-test--text node) "\n")))
        (should (= 5 (length lines)))
        (should (string-match-p "day (a) → dusk → night" (car lines)))
        (should (equal '(file "/d" 13) (get-text-property 1 'homun-kit-open (nth 4 lines))))))))

(ert-deftest homun-stage-project-specs-validate ()
  (let ((homun-stage-dir (file-name-as-directory (make-temp-file "stage" t)))
        (homun-stage-scenes (make-hash-table :test #'equal)))
    (dolist (s homun-stage-project-scenes)
      (should (homun-stage-show "t" (car s) (cadr s) (homun-stage-project-spec (car s)) "ephemeral")))
    (dolist (b (buffer-list)) (when (string-prefix-p "*stage " (buffer-name b)) (kill-buffer b)))))

(provide 'homun-stage-kit-parts-test)
;;; homun-stage-kit-parts-test.el ends here

(ert-deftest homun-stage-kit-prs-reads-cache-by-mtime ()
  (homun-stage-kit-parts-test--with
    (let* ((dir (make-temp-file "stage" t)) (homun-stage-kit-prs-cache-dir (file-name-as-directory dir))
           (node '((type . "prs") (repo . "o/r") (width . 40))) (key (homun-stage-kit--prs-key node))
           (cache (homun-stage-kit--prs-cache "o/r")))
      (should (equal (file-name-nondirectory cache) "prs-o-r.json"))
      (homun-stage-kit--prs-source node key)
      (should (string-match-p "waiting" (plist-get (homun-stage-kit-get key) :error)))
      (with-temp-file cache (insert "[{\"number\":7,\"title\":\"t\",\"url\":\"u\",\"state\":\"OPEN\",\"additions\":1,\"deletions\":2}]"))
      (cl-letf (((symbol-function 'homun-proc-async) (lambda (&rest _) (error "gh must not run"))))
        (homun-stage-kit--prs-source node key))
      (should (null (plist-get (homun-stage-kit-get key) :error)))
      (should (= 7 (caar (plist-get (homun-stage-kit-get key) :prs))))
      (let ((stamp (plist-get (homun-stage-kit-get key) :stamp)))
        (homun-stage-kit--prs-source node key)
        (should (eq stamp (plist-get (homun-stage-kit-get key) :stamp)))))))

(ert-deftest homun-stage-kit-touch-target-requests ()
  (homun-stage-kit-parts-test--with
    (let* ((dir (make-temp-file "stage" t)) (req (expand-file-name "sub/request" dir)) (key '("prs" "o/r")))
      (with-temp-buffer (insert (propertize "x" 'homun-kit-open `(touch ,req ,key))) (goto-char 1) (homun-stage-kit-open))
      (should (file-exists-p req))
      (should (= 0 (gethash key homun-stage-kit--polled))))))

(ert-deftest homun-stage-kit-checklist-file ()
  (homun-stage-kit-parts-test--with
    (let* ((f (homun-stage-kit-parts-test--tmp "# M\n\n- [x] M0 first\n- [~] M3 now\n- [ ] M4 later\n"))
           (node `((type . "checklist") (label . "ms") (file . ,f) (width . 30)))
           (key (list "checklist" f)))
      (homun-stage-kit--checklist-source node key)
      (should (equal (plist-get (homun-stage-kit-get key) :items)
                     '(("M0 first" "done" 3) ("M3 now" "now" 4) ("M4 later" "next" 5))))
      (let ((lines (split-string (homun-stage-kit-parts-test--text node) "\n")))
        (should (string-match-p "✓ M0 first" (nth 1 lines)))
        (should (string-match-p "▸ M3 now" (nth 2 lines)))
        (should (equal `(file ,f 5) (get-text-property 1 'homun-kit-open (nth 3 lines))))))))
