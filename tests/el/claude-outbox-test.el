;;; claude-outbox-test.el --- ERT for the outbox state machine and the focus hold -*- lexical-binding: t -*-
;; emacs --batch -L container/emacs -l tests/el/claude-outbox-test.el -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'claude-compose)

(ert-deftest claude-outbox-move-allows-only-listed-moves ()
  (let ((m (list :state 'pending)))
    (claude-outbox-move m 'held)
    (claude-outbox-move m 'pending)
    (claude-outbox-move m 'sending)
    (claude-outbox-move m 'failed "no")
    (should (equal "no" (plist-get m :error)))
    (claude-outbox-move m 'pending)
    (should (null (plist-get m :error)))
    (claude-outbox-move m 'sent)
    (should-error (claude-outbox-move m 'pending))
    (should (eq 'sent (plist-get m :state)))))

(ert-deftest claude-outbox-move-refuses-the-impossible ()
  (dolist (case '((sending held) (sending cancelled) (failed sending) (failed sent)
                  (sent failed) (cancelled pending) (held sending-x)))
    (let ((m (list :state (car case))))
      (should-error (claude-outbox-move m (cadr case)))
      (should (eq (car case) (plist-get m :state))))))

(ert-deftest claude-outbox-hold-follows-focus ()
  (let ((a (list :state 'pending)) (b (list :state 'sending)) (c (list :state 'failed))
        (d (list :state 'held)))
    (should (claude-outbox-hold (list a b c) t))
    (should (equal '(held sending failed) (mapcar (lambda (m) (plist-get m :state)) (list a b c))))
    (should-not (claude-outbox-hold (list a b c) t))
    (should (claude-outbox-hold (list a b c d) nil))
    (should (equal '(pending sending failed pending)
                   (mapcar (lambda (m) (plist-get m :state)) (list a b c d))))))

(defmacro claude-outbox-test--box (&rest body)
  `(let* ((dir (make-temp-file "cal" t))
          (claude-compose-queue-dir (expand-file-name "queue" dir))
          (claude-compose--outbox nil) (claude-compose--info nil) (claude-compose--process nil)
          (claude-compose--held nil) (claude-compose-outbox-functions nil)
          (claude-compose--bus-watches nil))
     (make-directory claude-compose-queue-dir t)
     (unwind-protect (progn ,@body) (delete-directory dir t))))

(defun claude-outbox-test--states ()
  (mapcar (lambda (m) (plist-get m :state)) claude-compose--outbox))

(ert-deftest claude-outbox-focused-queue-holds-and-releases ()
  (claude-outbox-test--box
   (let ((focused t) (sent nil))
     (cl-letf (((symbol-function 'claude-outbox-focused-p) (lambda () focused))
               ((symbol-function 'claude-compose--start)
                (lambda (_c text done) (push text sent) (funcall done nil) nil)))
       (claude-compose--focus-update)
       (claude-compose--enqueue "one")
       (should (equal '(held) (claude-outbox-test--states)))
       (should-not sent)
       (should (file-exists-p (claude-compose--queue-path "paused")))
       (setq focused nil)
       (claude-compose--focus-update)
       (should (equal '("one") sent))
       (should (equal '(sent) (claude-outbox-test--states)))
       (should-not (file-exists-p (claude-compose--queue-path "paused")))))))

(ert-deftest claude-outbox-held-message-can-be-cancelled-or-edited ()
  (claude-outbox-test--box
   (let ((focused t))
     (cl-letf (((symbol-function 'claude-outbox-focused-p) (lambda () focused))
               ((symbol-function 'claude-compose--show) #'ignore)
               ((symbol-function 'claude-compose--input) (lambda () ""))
               ((symbol-function 'claude-compose--set-input) #'ignore))
       (claude-compose--focus-update)
       (claude-compose--enqueue "one")
       (claude-compose--enqueue "two")
       (let ((id (plist-get (car claude-compose--outbox) :id)))
         (claude-compose-queued-cancel id)
         (should (equal '("two") (mapcar (lambda (m) (plist-get m :text)) claude-compose--outbox)))
         (should-not (file-exists-p (claude-compose--queue-path id))))
       (let ((id (plist-get (car claude-compose--outbox) :id)))
         (claude-compose-queued-edit id)
         (should-not claude-compose--outbox)
         (should-not (claude-compose--queue-names)))))))
