;;; homun-reload-test.el --- ERT: a reload leaves no stale advice, hook or timer -*- lexical-binding: t -*-
(require 'ert)
(require 'homun-stage-work)
(require 'homun-stage-live)

(ert-deftest homun-reload-test-sync-advice-dropped ()
  (let (n)
    (advice-add 'homun-stage-work-sync :after (lambda (items) (setq n items)))
    (advice-add 'homun-stage-work-sync :after #'homun-stage-live-work-refresh)
    (load (locate-library "homun-stage-live") nil t)
    (load (locate-library "homun-stage-live") nil t)
    (let ((c 0)) (advice-mapc (lambda (&rest _) (cl-incf c)) 'homun-stage-work-sync)
         (should (= c 0)))
    (should (= 1 (cl-count #'homun-stage-live-insert homun-stage-render-functions)))
    (cl-letf (((symbol-function 'homun-stage-work--read) (lambda (&rest _) nil)))
      (ignore-errors (homun-stage-work-sync)))
    (should-not n)))

(ert-deftest homun-reload-test-sched-timer-single ()
  (require 'claude)
  (let ((claude-sched--timer nil) (before (length timer-list)))
    (cl-letf (((symbol-function 'claude-sched-refresh) #'ignore))
      (claude-sched--arm) (claude-sched--arm) (claude-sched--arm))
    (should (= 1 (- (length timer-list) before)))
    (cancel-timer claude-sched--timer)))
