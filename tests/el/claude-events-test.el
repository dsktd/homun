;;; claude-events-test.el --- tests for claude-events -*- lexical-binding: t -*-
(require 'ert)
(require 'claude-events)

(ert-deftest events-hook-line ()
  (let ((i (claude-events-parse-hook-line
            "{\"ts\":100,\"event\":\"Notification\",\"session\":\"s\",\"kind\":\"idle_prompt\",\"summary\":\"waiting\"}")))
    (should (eq (plist-get i :class) 'n))
    (should (equal (plist-get i :summary) "waiting")))
  (should-not (claude-events-parse-hook-line "garbage"))
  (should (eq (plist-get (claude-events-parse-hook-line "{\"ts\":1,\"event\":\"PreToolUse\",\"summary\":\"Bash ls\"}") :class) 't)))

(ert-deftest events-transcript-lines ()
  (let ((e (car (claude-events-parse-transcript-line
                 "{\"type\":\"assistant\",\"isApiErrorMessage\":true,\"error\":\"rate_limit\",\"timestamp\":\"2026-11-22T10:00:00Z\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"You've hit your 5-hour limit · resets 9:40pm (X)\"}]}}"))))
    (should (equal (plist-get e :event) "ApiError"))
    (should (equal (plist-get e :kind) "rate_limit")))
  (let ((r (claude-events-parse-transcript-line
            "{\"type\":\"attachment\",\"timestamp\":\"2026-11-22T10:00:00Z\",\"attachment\":{\"type\":\"mcp_instructions_delta\",\"addedNames\":[\"a\"],\"removedNames\":[\"b\"]}}")))
    (should (equal (mapcar (lambda (i) (plist-get i :event)) r) '("McpAdded" "McpRemoved"))))
  (should-not (claude-events-parse-transcript-line "{\"type\":\"user\"}")))

(ert-deftest events-reset-time ()
  (let* ((now (float-time (encode-time '(0 0 20 22 11 2026 nil -1 nil))))
         (at (claude-events--reset-time "resets 9:40pm (Asia/Tokyo)" now)))
    (should (equal (format-time-string "%H:%M" at) "21:40"))
    (should (< 0 (- at now) 86400))
    (should (> (claude-events--reset-time "resets 8am" now) now))
    (should-not (claude-events--reset-time "nothing" now))))

(ert-deftest events-toast-and-dedupe ()
  (let ((claude-events--items nil) (claude-events--unread nil) (claude-events--rate-until nil)
        (claude-events--toasted nil) (msgs nil))
    (cl-letf (((symbol-function 'message) (lambda (f &rest a) (push (apply #'format f a) msgs))))
      (claude-events--add (claude-events--item 100 "StopFailure" "s" "rate_limit" "limit resets 9:40pm") t)
      (claude-events--add (claude-events--item 105 "ApiError" "s" "rate_limit" "limit") t)
      (claude-events--add (claude-events--item 106 "PreToolUse" "s" "" "Bash x") t))
    (should (= (length claude-events--items) 2))
    (should (= (length msgs) 1))
    (should claude-events--unread)
    (should claude-events--rate-until)))

(ert-deftest events-mcp-removal-waits-and-repeats-coalesce ()
  (let ((claude-events--items nil) (claude-events--unread nil) (claude-events--mcp-removed nil)
        (claude-events--toasted nil) (msgs nil))
    (cl-letf (((symbol-function 'message) (lambda (f &rest a) (push (apply #'format f a) msgs))))
      ;; A server that comes back within the grace is never announced
      (claude-events--add (claude-events--item 100 "McpRemoved" "s" "mcp" "docs") t)
      (claude-events--add (claude-events--item 100 "McpRemoved" "s" "mcp" "easel") t)
      (claude-events--add (claude-events--item 120 "McpAdded" "s" "mcp" "docs") t)
      (claude-events--check-mcp 150)
      (should-not msgs)
      (claude-events--check-mcp 170)
      (claude-events--check-mcp 180)
      (should (equal msgs '("Claude: MCP server easel gone for over 60s")))
      ;; The same event and summary within 30 s is said once
      (setq msgs nil)
      (claude-events--add (claude-events--item 200 "Notification" "s" "idle_prompt" "waiting") t)
      (claude-events--add (claude-events--item 210 "Notification" "s" "idle_prompt" "waiting") t)
      (should (= (length msgs) 1))
      (claude-events--add (claude-events--item 260 "Notification" "s" "idle_prompt" "waiting") t)
      (should (= (length msgs) 2)))))

(ert-deftest events-stall ()
  (let ((claude-events--items (list (claude-events--item 100 "PostToolUse" "s" "" "Bash")))
        (claude-events--stall-for nil) (claude-events--unread nil) (n 0))
    (cl-letf (((symbol-function 'message) (lambda (&rest _) (cl-incf n))))
      (claude-events--check-stall 130) (should (= n 0))
      (claude-events--check-stall 170) (claude-events--check-stall 180) (should (= n 1))
      (setq claude-events--items (list (claude-events--item 100 "Stop" "s" "" "")))
      (setq claude-events--stall-for nil)
      (claude-events--check-stall 400) (should (= n 1)))))

(ert-deftest events-filters-and-read ()
  (let ((f (make-temp-file "ev")) (claude-events--log-pos 0) (claude-events--items nil))
    (with-temp-file f (insert "{\"ts\":1,\"event\":\"Stop\"}\n{\"ts\":2,\"event\":\"PreToolUse\"}\n{\"ts\":3,\"ev"))
    (let ((r (claude-events--new-lines f 0)))
      (should (= (length (car r)) 2))
      ;; The position is the end of the last whole line: nothing is read twice or skipped
      (should (= (cdr r) (length "{\"ts\":1,\"event\":\"Stop\"}\n{\"ts\":2,\"event\":\"PreToolUse\"}\n")))
      (should (equal (claude-events--new-lines f (cdr r)) (cons nil (cdr r)))))
    (should (= (length (claude-events--visible
                        (list (claude-events--item 1 "Stop" "" "" "") (claude-events--item 2 "PreToolUse" "" "" ""))
                        '(t))) 1))
    (delete-file f)))
