{
  "channelsEnabled": true,
  "allowedChannelPlugins": [
    {
      "marketplace": "claude-wrapper-local",
      "plugin": "scheduler-channel"
    }
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$DBUS_SESSION_BUS_ADDRESS\" ] && notify-send --app-name=Claude \"Claude: $(hostname)\" \"$(jq -r '.message // \"Needs your input\"')\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/usage-hook.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/usage-hook.sh"
          },
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/follow-hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/usage-hook.sh"
          },
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/follow-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh /opt/claude-wrapper/follow-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "claude-digest || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /opt/claude-wrapper/statusline.sh"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "150000"
  }
}
